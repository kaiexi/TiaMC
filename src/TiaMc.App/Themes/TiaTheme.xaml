    <!-- =====================================================================
         4. CONTROL TEMPLATES
         ===================================================================== -->

    <!-- flat button -->
    <ControlTemplate x:Key="Tia.ButtonTemplate" TargetType="{x:Type Button}">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                SnapsToDevicePixels="True">
            <Grid>
                <ContentPresenter x:Name="BtnContent"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                <Border x:Name="FocusRing"
                        Margin="1"
                        BorderBrush="{StaticResource Tia.Accent}"
                        BorderThickness="1"
                        Visibility="Collapsed"
                        SnapsToDevicePixels="True"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Pressed}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.PanelBgAlt}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tia.Border}"/>
                <Setter Property="Foreground" Value="{StaticResource Tia.TextDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- primary / brand button -->
    <ControlTemplate x:Key="Tia.ButtonPrimaryTemplate" TargetType="{x:Type Button}">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                SnapsToDevicePixels="True">
            <Grid>
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True"/>
                <Border x:Name="FocusRing"
                        Margin="1"
                        BorderBrush="{StaticResource Tia.Accent}"
                        BorderThickness="1"
                        Visibility="Collapsed"
                        SnapsToDevicePixels="True"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.BrandLight}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.BrandDark}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.PanelBgAlt}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tia.Border}"/>
                <Setter Property="Foreground" Value="{StaticResource Tia.TextDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ribbon tool button: no chrome until hover -->
    <ControlTemplate x:Key="Tia.ButtonToolTemplate" TargetType="{x:Type Button}">
        <Border x:Name="Bd"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Hover}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tia.Border}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Pressed}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tia.BorderStrong}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Tia.TextDisabled}"/>
                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- window chrome button (min / max) -->
    <ControlTemplate x:Key="Tia.ButtonChromeTemplate" TargetType="{x:Type Button}">
        <Border x:Name="Bd" Background="Transparent" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="False"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.ChromeHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.ChromePressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Tia.TextDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- window chrome close button -->
    <ControlTemplate x:Key="Tia.ButtonChromeCloseTemplate" TargetType="{x:Type Button}">
        <Border x:Name="Bd" Background="Transparent" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="False"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.ChromeCloseHover}"/>
                <Setter Property="Foreground" Value="{StaticResource Tia.TextOnBrand}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Error}"/>
                <Setter Property="Foreground" Value="{StaticResource Tia.TextOnBrand}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Tia.TextDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ribbon large command button -->
    <ControlTemplate x:Key="Tia.ButtonRibbonBigTemplate" TargetType="{x:Type Button}">
        <Border x:Name="Bd"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Hover}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tia.Border}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Pressed}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tia.BorderStrong}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Tia.TextDisabled}"/>
                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- text box -->
    <ControlTemplate x:Key="Tia.TextBoxTemplate" TargetType="{x:Type TextBox}">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          Background="Transparent"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tia.BorderStrong}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tia.BrandLight}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.PanelBgAlt}"/>
                <Setter Property="Foreground" Value="{StaticResource Tia.TextDisabled}"/>
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.PanelBg}"/>
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tia.Error}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- password box -->
    <ControlTemplate x:Key="Tia.PasswordBoxTemplate" TargetType="{x:Type PasswordBox}">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          Background="Transparent"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tia.BorderStrong}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tia.BrandLight}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.PanelBgAlt}"/>
                <Setter Property="Foreground" Value="{StaticResource Tia.TextDisabled}"/>
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tia.Error}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- console / log text box -->
    <ControlTemplate x:Key="Tia.ConsoleTextBoxTemplate" TargetType="{x:Type TextBox}">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          Background="Transparent"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"/>
        </Border>
    </ControlTemplate>

    <!-- combo box (non editable) -->
    <ControlTemplate x:Key="Tia.ComboBoxTemplate" TargetType="{x:Type ComboBox}">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"/>
            <ToggleButton x:Name="ToggleButton"
                          Background="Transparent"
                          BorderThickness="0"
                          ClickMode="Press"
                          Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid Background="Transparent">
                            <Path x:Name="Arrow"
                                  Width="10"
                                  Height="6"
                                  Margin="0,0,7,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource Icon.ChevronDown}"
                                  Fill="{StaticResource Tia.TextMuted}"
                                  Stretch="Fill"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource Tia.Brand}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource Tia.TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="ContentSite"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              IsHitTestVisible="False"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom"
                   PopupAnimation="None">
                <Popup.Resources>
                    <Style TargetType="{x:Type ScrollViewer}">
                        <Setter Property="CanContentScroll" Value="True"/>
                    </Style>
                </Popup.Resources>
                <Border x:Name="DropDownBorder"
                        MinWidth="{Binding ActualWidth, ElementName=Bd}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Margin="0,1,0,0"
                        Background="{StaticResource Tia.ContentBg}"
                        BorderBrush="{StaticResource Tia.BorderStrong}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="False">
                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="24"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tia.BorderStrong}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tia.BrandLight}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.PanelBgAlt}"/>
                <Setter Property="Foreground" Value="{StaticResource Tia.TextDisabled}"/>
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tia.Error}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- combo box item -->
    <ControlTemplate x:Key="Tia.ComboBoxItemTemplate" TargetType="{x:Type ComboBoxItem}">
        <Border x:Name="Bd"
                Background="Transparent"
                BorderThickness="0"
                SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Hover}"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Selection}"/>
                <Setter Property="Foreground" Value="{StaticResource Tia.SelectionText}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Tia.TextDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- check box -->
    <ControlTemplate x:Key="Tia.CheckBoxTemplate" TargetType="{x:Type CheckBox}">
        <Grid SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Box"
                    Width="14"
                    Height="14"
                    Background="{StaticResource Tia.ContentBg}"
                    BorderBrush="{StaticResource Tia.BorderStrong}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <Path x:Name="Tick"
                      Width="10"
                      Height="8"
                      Data="{StaticResource Icon.Check}"
                      Fill="{StaticResource Tia.TextOnBrand}"
                      Stretch="Fill"
                      Visibility="Collapsed"/>
            </Border>
            <ContentPresenter x:Name="Label"
                              Grid.Column="1"
                              Margin="6,0,0,0"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Tia.Brand}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Tia.BrandDark}"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Tia.Brand}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Tia.BrandDark}"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Tick" Property="Opacity" Value="0.55"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Tia.BrandLight}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Tia.Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Tia.PanelBgAlt}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Tia.Border}"/>
                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource Tia.TextDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- radio button -->
    <ControlTemplate x:Key="Tia.RadioButtonTemplate" TargetType="{x:Type RadioButton}">
        <Grid SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Ring"
                    Width="14"
                    Height="14"
                    Background="{StaticResource Tia.ContentBg}"
                    BorderBrush="{StaticResource Tia.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="7"
                    SnapsToDevicePixels="True">
                <Ellipse x:Name="Dot"
                         Width="6"
                         Height="6"
                         Fill="{StaticResource Tia.Brand}"
                         Visibility="Collapsed"/>
            </Border>
            <ContentPresenter x:Name="Label"
                              Grid.Column="1"
                              Margin="6,0,0,0"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Tia.Brand}"/>
                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Tia.BrandLight}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Tia.Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Ring" Property="Background" Value="{StaticResource Tia.PanelBgAlt}"/>
                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Tia.Border}"/>
                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Tia.TextDisabled}"/>
                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource Tia.TextDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- slider -->
    <ControlTemplate x:Key="Tia.SliderTemplate" TargetType="{x:Type Slider}">
        <Border Background="Transparent" SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TickBar x:Name="TopTick"
                         Grid.Row="0"
                         Height="4"
                         Margin="0,0,0,2"
                         Fill="{StaticResource Tia.BorderStrong}"
                         Placement="Top"
                         Visibility="Collapsed"/>
                <TickBar x:Name="BottomTick"
                         Grid.Row="2"
                         Height="4"
                         Margin="0,2,0,0"
                         Fill="{StaticResource Tia.BorderStrong}"
                         Placement="Bottom"
                         Visibility="Collapsed"/>
                <Track x:Name="PART_Track" Grid.Row="1" VerticalAlignment="Center">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                    <Border Background="Transparent" SnapsToDevicePixels="True"/>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                    <Border Background="Transparent" SnapsToDevicePixels="True"/>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb x:Name="Thumb" Width="11" Height="15" Focusable="False">
                            <Thumb.Template>
                                <ControlTemplate TargetType="{x:Type Thumb}">
                                    <Border x:Name="ThumbBd"
                                            Background="{StaticResource Tia.Brand}"
                                            BorderBrush="{StaticResource Tia.BrandDark}"
                                            BorderThickness="1"
                                            CornerRadius="1"
                                            SnapsToDevicePixels="True"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource Tia.BrandLight}"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource Tia.BrandDark}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                </Track>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="TickPlacement" Value="TopLeft">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="TickPlacement" Value="BottomRight">
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="TickPlacement" Value="Both">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible"/>
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Thumb" Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- progress bar -->
    <ControlTemplate x:Key="Tia.ProgressBarTemplate" TargetType="{x:Type ProgressBar}">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                SnapsToDevicePixels="True">
            <Grid>
                <Rectangle x:Name="PART_Track"/>
                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"/>
            </Grid>
        </Border>
    </ControlTemplate>

    <!-- indeterminate progress bar (separate opt-in style) -->
    <ControlTemplate x:Key="Tia.ProgressBarIndeterminateTemplate" TargetType="{x:Type ProgressBar}">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                SnapsToDevicePixels="True">
            <Grid>
                <Rectangle x:Name="PART_Track"/>
                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"/>
                <Rectangle x:Name="Pulse"
                           Fill="{StaticResource Tia.BrandLight}"
                           Opacity="0.45"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="PulseStory">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="Pulse"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.15"
                                             To="0.55"
                                             Duration="0:0:0.9"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="PulseStory"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_Indicator" Property="Fill" Value="{StaticResource Tia.TextDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- group box -->
    <ControlTemplate x:Key="Tia.GroupBoxTemplate" TargetType="{x:Type GroupBox}">
        <Grid SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="{StaticResource Tia.PanelBgAlt}"
                    BorderBrush="{StaticResource Tia.Border}"
                    BorderThickness="1,1,1,0"
                    Padding="6,3">
                <ContentPresenter ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  TextElement.FontSize="12"
                                  TextElement.FontWeight="SemiBold"
                                  TextElement.Foreground="{StaticResource Tia.Brand}"/>
            </Border>
            <Border Grid.Row="1"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{StaticResource Tia.Border}"
                    BorderThickness="1"
                    Padding="6">
                <ContentPresenter Margin="{TemplateBinding Padding}"/>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- menu item (top level and submenu share this template) -->
    <ControlTemplate x:Key="Tia.MenuItemTemplate" TargetType="{x:Type MenuItem}">
        <Grid SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIconColumnGroup"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Bd"
                    Grid.ColumnSpan="4"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1"/>
            <ContentPresenter x:Name="Icon"
                              Grid.Column="0"
                              Width="18"
                              Height="16"
                              Margin="3,0,4,0"
                              VerticalAlignment="Center"
                              ContentSource="Icon"/>
            <Path x:Name="Check"
                  Grid.Column="0"
                  Width="10"
                  Height="8"
                  Margin="3,0,4,0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Data="{StaticResource Icon.Check}"
                  Fill="{StaticResource Tia.Brand}"
                  Stretch="Fill"
                  Visibility="Collapsed"/>
            <ContentPresenter x:Name="HeaderHost"
                              Grid.Column="1"
                              Margin="4,0,8,0"
                              VerticalAlignment="Center"
                              ContentSource="Header"
                              RecognizesAccessKey="True"/>
            <TextBlock x:Name="IGT"
                       Grid.Column="2"
                       Margin="8,0,8,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource Tia.TextMuted}"
                       Text="{TemplateBinding InputGestureText}"/>
            <Path x:Name="SubArrow"
                  Grid.Column="3"
                  Width="5"
                  Height="9"
                  Margin="0,0,5,0"
                  VerticalAlignment="Center"
                  Data="M0,0 L5,5 L0,10 Z"
                  Fill="{StaticResource Tia.TextMuted}"
                  Stretch="Fill"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Hover}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tia.Border}"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Hover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Tia.TextDisabled}"/>
                <Setter TargetName="IGT" Property="Foreground" Value="{StaticResource Tia.TextDisabled}"/>
                <Setter TargetName="SubArrow" Property="Fill" Value="{StaticResource Tia.TextDisabled}"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter TargetName="SubArrow" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.PanelBgAlt}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tia.Border}"/>
                <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter TargetName="SubArrow" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="IGT" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter TargetName="SubArrow" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="IGT" Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Menu separators
         A Menu/ContextMenu cannot carry a "Resources" Setter (Resources is a
         read-only property, so Setter rejects it), which removes the usual
         MenuItem.SeparatorStyleKey route for styling menu separators from a
         style. Menu/ContextMenu item templates are still fully themed; only the
         separator rows keep the default system rendering. Separators outside
         menus use Style="{StaticResource Tia.Separator}". -->

    <!-- ribbon tab control -->
    <ControlTemplate x:Key="Tia.RibbonTabControlTemplate" TargetType="{x:Type TabControl}">
        <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{StaticResource Tia.RibbonBg}">
                <TabPanel x:Name="HeaderPanel"
                          MinHeight="26"
                          Margin="2,0,2,0"
                          IsItemsHost="True"
                          KeyboardNavigation.TabIndex="1"
                          Panel.ZIndex="1"/>
            </Grid>
            <Border x:Name="ContentPanel"
                    Grid.Row="1"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{StaticResource Tia.Border}"
                    BorderThickness="1,1,1,0"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    KeyboardNavigation.TabIndex="2"
                    KeyboardNavigation.TabNavigation="Local">
                <ContentPresenter x:Name="PART_SelectedContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  ContentSource="SelectedContent"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- ribbon tab item -->
    <ControlTemplate x:Key="Tia.RibbonTabItemTemplate" TargetType="{x:Type TabItem}">
        <Border x:Name="Bd"
                Margin="0,2,1,0"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1,1,1,0"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="TopRule"
                        Grid.Row="0"
                        Background="Transparent"
                        SnapsToDevicePixels="True"/>
                <ContentPresenter x:Name="HeaderHost"
                                  Grid.Row="1"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.ContentBg}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tia.Border}"/>
                <Setter TargetName="TopRule" Property="Background" Value="{StaticResource Tia.Brand}"/>
                <Setter Property="Foreground" Value="{StaticResource Tia.Text}"/>
                <Setter Property="Panel.ZIndex" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Tia.TextDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- document tab item -->
    <ControlTemplate x:Key="Tia.TabItemTemplate" TargetType="{x:Type TabItem}">
        <Border x:Name="Bd"
                Margin="0,3,1,0"
                Background="{StaticResource Tia.PanelBgAlt}"
                BorderBrush="{StaticResource Tia.Border}"
                BorderThickness="1,1,1,0"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="TopRule"
                        Grid.Row="0"
                        Background="Transparent"
                        SnapsToDevicePixels="True"/>
                <ContentPresenter x:Name="HeaderHost"
                                  Grid.Row="1"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.ContentBg}"/>
                <Setter TargetName="TopRule" Property="Background" Value="{StaticResource Tia.Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource Tia.Text}"/>
                <Setter Property="Panel.ZIndex" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Tia.TextDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- document tab control -->
    <ControlTemplate x:Key="Tia.TabControlTemplate" TargetType="{x:Type TabControl}">
        <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TabPanel x:Name="HeaderPanel"
                      Grid.Row="0"
                      MinHeight="26"
                      Margin="2,0,2,0"
                      IsItemsHost="True"
                      KeyboardNavigation.TabIndex="1"
                      Panel.ZIndex="1"/>
            <Border x:Name="ContentPanel"
                    Grid.Row="1"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{StaticResource Tia.Border}"
                    BorderThickness="1,1,1,0"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    KeyboardNavigation.TabIndex="2"
                    KeyboardNavigation.TabNavigation="Local">
                <ContentPresenter x:Name="PART_SelectedContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  ContentSource="SelectedContent"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- tree view item: flat row + rotating triangle -->
    <ControlTemplate x:Key="Tia.TreeViewItemTemplate" TargetType="{x:Type TreeViewItem}">
        <Grid SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ToggleButton x:Name="Expander"
                          Grid.Row="0"
                          Grid.Column="0"
                          Width="14"
                          Height="18"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          ClickMode="Press"
                          Focusable="False"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid Background="Transparent">
                            <Path x:Name="Glyph"
                                  Width="9"
                                  Height="9"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource Icon.TreeExpander}"
                                  Fill="{StaticResource Tia.TextMuted}"
                                  Stretch="Fill"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- The expanded glyph is swapped as geometry rather than by
                                 targeting a named RotateTransform: a named transform lives in
                                 its own name scope, so TargetName cannot reach it from a
                                 ControlTemplate trigger (MC4111). -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.TreeExpanderOpen}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Fill" Value="{StaticResource Tia.Brand}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Glyph" Property="Fill" Value="{StaticResource Tia.TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <Border x:Name="Bd"
                    Grid.Row="0"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    SnapsToDevicePixels="True">
                <ContentPresenter x:Name="PART_Header"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="Center"
                                  ContentSource="Header"/>
            </Border>
            <ItemsPresenter x:Name="ItemsHost"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="14,0,0,0"
                            Visibility="Collapsed"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
            </Trigger>
            <Trigger Property="IsMouseOver" SourceName="Bd" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Selection}"/>
                <Setter Property="Foreground" Value="{StaticResource Tia.SelectionText}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Tia.TextDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- tree view -->
    <ControlTemplate x:Key="Tia.TreeViewTemplate" TargetType="{x:Type TreeView}">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ScrollViewer"
                          Padding="{TemplateBinding Padding}"
                          Background="Transparent"
                          CanContentScroll="True"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <ItemsPresenter/>
            </ScrollViewer>
        </Border>
    </ControlTemplate>

    <!-- list box item -->
    <ControlTemplate x:Key="Tia.ListBoxItemTemplate" TargetType="{x:Type ListBoxItem}">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderThickness="0"
                SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsSelected" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Hover}"/>
            </MultiTrigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Selection}"/>
                <Setter Property="Foreground" Value="{StaticResource Tia.SelectionText}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Tia.TextDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- list view item (used by the TIA table look) -->
    <ControlTemplate x:Key="Tia.ListViewItemTemplate" TargetType="{x:Type ListViewItem}">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{StaticResource Tia.Border}"
                BorderThickness="0,0,0,1"
                SnapsToDevicePixels="True">
            <!-- GridViewRowPresenter takes Content and generates the cells from
                 Columns. It has no ContentTemplate dependency property, so only
                 those two are bound. No Style is set here: a StaticResource
                 lookup from inside a ControlTemplate is not guaranteed to reach
                 a key that lives in the merged dictionary, so templates only
                 reference keys declared locally. -->
            <GridViewRowPresenter x:Name="RowHost"
                                  Columns="{TemplateBinding GridView.ColumnCollection}"
                                  Content="{TemplateBinding Content}"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.RowAlt}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsSelected" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Hover}"/>
            </MultiTrigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Selection}"/>
                <Setter Property="Foreground" Value="{StaticResource Tia.SelectionText}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Tia.TextDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- grid view column header: keeps the native resize gripper -->
    <ControlTemplate x:Key="Tia.GridViewColumnHeaderTemplate" TargetType="{x:Type GridViewColumnHeader}">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{StaticResource Tia.Border}"
                    BorderThickness="0,0,1,1"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter x:Name="Content"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
            </Border>
            <Thumb x:Name="PART_HeaderGripper"
                   Width="8"
                   HorizontalAlignment="Right"
                   Cursor="SizeWE"
                   Focusable="False">
                <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="GripMark"
                                       Width="1"
                                       HorizontalAlignment="Center"
                                       Fill="{StaticResource Tia.Border}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GripMark" Property="Fill" Value="{StaticResource Tia.BrandLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.PanelBg}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- grid view row presenter: rows keep an explicit 1px horizontal gridline.
         The default presenter is used so generated cells stay intact; the
         gridline is declared on the item container. -->
    <Style x:Key="Tia.GridViewRowPresenter" TargetType="{x:Type GridViewRowPresenter}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- scroll bar -->
    <ControlTemplate x:Key="Tia.ScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Background="{StaticResource Tia.PanelBgAlt}" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <RepeatButton x:Name="PART_LineUpButton"
                          Grid.Row="0"
                          Grid.Column="1"
                          Command="ScrollBar.LineUpCommand"
                          Focusable="False"
                          Style="{x:Null}">
                <RepeatButton.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Grid Background="Transparent">
                            <Path x:Name="Arrow"
                                  Width="7"
                                  Height="4"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M0,4 L3.5,0 L7,4 Z"
                                  Fill="{StaticResource Tia.TextMuted}"
                                  Stretch="Fill"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource Tia.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RepeatButton.Template>
            </RepeatButton>
            <RepeatButton x:Name="PART_LineDownButton"
                          Grid.Row="2"
                          Grid.Column="1"
                          Command="ScrollBar.LineDownCommand"
                          Focusable="False"
                          Style="{x:Null}">
                <RepeatButton.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Grid Background="Transparent">
                            <Path x:Name="Arrow"
                                  Width="7"
                                  Height="4"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M0,0 L3.5,4 L7,0 Z"
                                  Fill="{StaticResource Tia.TextMuted}"
                                  Stretch="Fill"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource Tia.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RepeatButton.Template>
            </RepeatButton>
            <RepeatButton x:Name="PART_LineLeftButton"
                          Grid.Row="1"
                          Grid.Column="0"
                          Command="ScrollBar.LineLeftCommand"
                          Focusable="False"
                          Style="{x:Null}">
                <RepeatButton.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Grid Background="Transparent">
                            <Path x:Name="Arrow"
                                  Width="4"
                                  Height="7"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M4,0 L0,3.5 L4,7 Z"
                                  Fill="{StaticResource Tia.TextMuted}"
                                  Stretch="Fill"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource Tia.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RepeatButton.Template>
            </RepeatButton>
            <RepeatButton x:Name="PART_LineRightButton"
                          Grid.Row="1"
                          Grid.Column="2"
                          Command="ScrollBar.LineRightCommand"
                          Focusable="False"
                          Style="{x:Null}">
                <RepeatButton.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Grid Background="Transparent">
                            <Path x:Name="Arrow"
                                  Width="4"
                                  Height="7"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M0,0 L4,3.5 L0,7 Z"
                                  Fill="{StaticResource Tia.TextMuted}"
                                  Stretch="Fill"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource Tia.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RepeatButton.Template>
            </RepeatButton>
            <Track x:Name="PART_Track"
                   Grid.Row="1"
                   Grid.Column="1"
                   IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Style="{x:Null}">
                        <RepeatButton.Template>
                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                <Border Background="Transparent" SnapsToDevicePixels="True"/>
                            </ControlTemplate>
                        </RepeatButton.Template>
                    </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Style="{x:Null}">
                        <RepeatButton.Template>
                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                <Border Background="Transparent" SnapsToDevicePixels="True"/>
                            </ControlTemplate>
                        </RepeatButton.Template>
                    </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="Thumb" MinHeight="18" MinWidth="18" Focusable="False">
                        <Thumb.Template>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Border x:Name="ThumbBd"
                                        Margin="2"
                                        Background="{StaticResource Tia.BorderStrong}"
                                        CornerRadius="1"
                                        SnapsToDevicePixels="True"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource Tia.TextMuted}"/>
                                    </Trigger>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource Tia.Brand}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_LineUpButton" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="PART_LineDownButton" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="PART_LineLeftButton" Property="Grid.Row" Value="0"/>
                <Setter TargetName="PART_LineLeftButton" Property="Grid.RowSpan" Value="3"/>
                <Setter TargetName="PART_LineLeftButton" Property="Grid.Column" Value="0"/>
                <Setter TargetName="PART_LineRightButton" Property="Grid.Row" Value="0"/>
                <Setter TargetName="PART_LineRightButton" Property="Grid.RowSpan" Value="3"/>
                <Setter TargetName="PART_LineRightButton" Property="Grid.Column" Value="2"/>
                <Setter TargetName="PART_Track" Property="Grid.Row" Value="1"/>
                <Setter TargetName="PART_Track" Property="Grid.RowSpan" Value="1"/>
                <Setter TargetName="PART_Track" Property="Grid.Column" Value="1"/>
                <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal"/>
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- =====================================================================
         5. STYLES - text
         ===================================================================== -->

    <!-- NOTE on key collisions (WPF requires every x:Key in one dictionary to be
         unique; a duplicate key silently replaces the earlier entry and a
         StaticResource of the wrong type throws InvalidCastException at load):

           * "Tia.Text" (#1E2A33) and "Tia.TextMuted" (#5C6B78) are the required
             BRUSH keys - Views/MainWindow.xaml consumes them as brushes, e.g.
             Foreground="{DynamicResource Tia.Text}". They therefore CANNOT also
             be TextBlock styles. The TextBlock styles are named:
                 Tia.TextBlock       (12px, neutral colour, inherits Foreground)
                 Tia.TextMutedText   (11.5px, Tia.TextMuted)  alias Tia.MutedText
             "Tia.TextStrong" is unambiguous (no brush by that name) and is used
             verbatim as the 12px SemiBold TextBlock style.
           * "Tia.StatusText" is consumed as a TextBlock Style, so it is the
             Style and the brush is "Tia.StatusBarText".
         Every other key in the required list is used verbatim. -->

    <Style x:Key="Tia.TextBlock" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Tia.TextStrong" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.Text}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="Tia.TextMutedText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.TextMuted}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="Tia.MutedText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Tia.TextMutedText}"/>

    <Style x:Key="Tia.SectionHeader" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.Brand}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="Tia.Label" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.TextMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="Tia.RibbonGroupLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.TextMuted}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Tia.StatusText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.StatusBarText}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Tia.StatusTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Tia.StatusText}"/>

    <Style x:Key="Tia.ToolTipText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.TextOnBrand}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- =====================================================================
         6. STYLES - buttons
         ===================================================================== -->

    <Style x:Key="Tia.Button" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.Text}"/>
        <Setter Property="Background" Value="{StaticResource Tia.PanelBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tia.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="MinHeight" Value="23"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource Tia.ButtonTemplate}"/>
    </Style>

    <Style x:Key="Tia.Button.Primary" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.TextOnBrand}"/>
        <Setter Property="Background" Value="{StaticResource Tia.Brand}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tia.BrandDark}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="MinHeight" Value="23"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource Tia.ButtonPrimaryTemplate}"/>
    </Style>

    <!-- orange button: server modpack actions are always highlighted in orange -->
    <Style x:Key="Tia.Button.ServerPack" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource Tia.ServerPackBadge}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tia.ServerPackText}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="MinHeight" Value="23"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.ServerPackText}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
