<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         TiaTheme.xaml - Siemens TIA Portal V17+ inspired WPF theme
         Flat industrial chrome. Squared corners (2px max). No gradients,
         no shadows, no blurs, no animations except one indeterminate bar.
         Self-sufficient: every StaticResource referenced here is declared
         earlier in this same file. No x:Class, no code-behind, no pack URIs.
         ===================================================================== -->

    <!-- =====================================================================
         1. PURE COLOUR TOKENS (namespaced "C." so brush keys stay unique)
         ===================================================================== -->
