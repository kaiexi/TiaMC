    <!-- industrial toggle switch: used as the authentication server on/off switch -->
    <Style x:Key="Tia.Switch" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <Border x:Name="Track" CornerRadius="8"
                                Background="{StaticResource Tia.PanelBgAlt}"
                                BorderBrush="{StaticResource Tia.BorderStrong}" BorderThickness="1"
                                SnapsToDevicePixels="True"/>
                        <Border x:Name="Knob" Width="12" Height="12" CornerRadius="6"
                                Background="{StaticResource Tia.BorderStrong}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                                SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Tia.Brand}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Tia.Brand}"/>
                            <Setter TargetName="Knob" Property="Background" Value="{StaticResource Tia.ContentBg}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Tia.Brand}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- horizontal bar splitter: used above the output window and between stacked lists -->
    <Style x:Key="Tia.Splitter.H" TargetType="{x:Type GridSplitter}">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Cursor" Value="SizeNS"/>
        <Setter Property="ResizeDirection" Value="Rows"/>
        <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="{StaticResource Tia.PanelBgAlt}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Tia.Border}" BorderThickness="0,1,0,1"
                            SnapsToDevicePixels="True">
                        <Border Height="2" Width="46" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{StaticResource Tia.BorderStrong}" CornerRadius="1"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Selection}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- =====================================================================
         10. STYLES - trees and lists
         ===================================================================== -->

    <Style x:Key="Tia.TreeViewItem" TargetType="{x:Type TreeViewItem}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="2,3"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource Tia.TreeViewItemTemplate}"/>
    </Style>

    <Style x:Key="Tia.TreeView" TargetType="{x:Type TreeView}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.Text}"/>
        <Setter Property="Background" Value="{StaticResource Tia.PanelBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tia.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Tia.TreeViewItem}"/>
        <Setter Property="Template" Value="{StaticResource Tia.TreeViewTemplate}"/>
    </Style>

    <Style x:Key="Tia.ListBoxItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="5,2"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource Tia.ListBoxItemTemplate}"/>
    </Style>

    <Style x:Key="Tia.ListBoxItem.Alt" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource Tia.ListBoxItem}">
        <Setter Property="MinHeight" Value="21"/>
    </Style>

    <Style x:Key="Tia.ListBox" TargetType="{x:Type ListBox}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.Text}"/>
        <Setter Property="Background" Value="{StaticResource Tia.PanelBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tia.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Tia.ListBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Padding="{TemplateBinding Padding}"
                                      Background="Transparent"
                                      Focusable="False">
                            <ItemsPresenter SnapsToDevicePixels="True"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tia.ListViewItem" TargetType="{x:Type ListViewItem}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.Text}"/>
        <Setter Property="Background" Value="{StaticResource Tia.ContentBg}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource Tia.ListViewItemTemplate}"/>
    </Style>

    <Style x:Key="Tia.GridViewColumnHeader" TargetType="{x:Type GridViewColumnHeader}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.TextMuted}"/>
        <Setter Property="Background" Value="{StaticResource Tia.PanelBgAlt}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tia.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource Tia.GridViewColumnHeaderTemplate}"/>
    </Style>

    <!-- GridView is a ViewBase, not a FrameworkElement, so it cannot carry a
         Style. Apply the header style directly instead:
             <GridView ColumnHeaderContainerStyle="{StaticResource Tia.GridViewColumnHeader}"/> -->

    <Style x:Key="Tia.ListView" TargetType="{x:Type ListView}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.Text}"/>
        <Setter Property="Background" Value="{StaticResource Tia.PanelBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tia.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Tia.ListViewItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListView}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Padding="{TemplateBinding Padding}"
                                      Background="Transparent"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter SnapsToDevicePixels="True"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =====================================================================
         11. STYLES - scrollbars, tooltips, misc
         ===================================================================== -->

    <Style x:Key="Tia.ScrollBar" TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="{StaticResource Tia.PanelBgAlt}"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="MinHeight" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource Tia.ScrollBarTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="12"/>
                <Setter Property="MinWidth" Value="12"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="MinHeight" Value="0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Tia.ScrollViewer" TargetType="{x:Type ScrollViewer}">
        <Setter Property="Background" Value="{StaticResource Tia.PanelBg}"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Tia.ToolTip" TargetType="{x:Type ToolTip}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.TextOnBrand}"/>
        <Setter Property="Background" Value="{StaticResource Tia.ToolTipBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tia.ToolTipBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5,3"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ribbon group caption shown under a command strip -->
    <Style x:Key="Tia.RibbonGroupCaptionHost" TargetType="{x:Type Grid}">
        <Setter Property="Margin" Value="0,1,0,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- =====================================================================
         9. STYLES - TIA style shell additions (breadcrumb, palette, pane tabs)
         ===================================================================== -->

    <Style x:Key="Tia.BreadcrumbRoot" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.TextMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Tia.BreadcrumbItem" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.Brand}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Tia.BreadcrumbSeparator" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.TextDisabled}"/>
        <Setter Property="Margin" Value="6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Tia.BreadcrumbCurrent" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.Text}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- palette section: TIA draws a bold header with a disclosure triangle -->
    <Style x:Key="Tia.PaletteHeaderToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="{StaticResource Tia.PanelBgAlt}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tia.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.Text}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Arrow" Grid.Column="0" Width="9" Height="9" Stretch="Uniform"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Fill="{StaticResource Tia.TextMuted}">
                                <Path.Style>
                                    <Style TargetType="{x:Type Path}">
                                        <Setter Property="Data" Value="{StaticResource Icon.TreeExpander}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                                                         Value="True">
                                                <Setter Property="Data" Value="{StaticResource Icon.TreeExpanderOpen}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <ContentPresenter Grid.Column="1" Margin="2,0,6,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Hover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tia.PaletteRow" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="0,0,0,1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tia.Border}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Selection}"/>
                            <Setter Property="Foreground" Value="{StaticResource Tia.SelectionText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- vertical pane selector on the far right, mirroring TIA's pane tabs -->
    <Style x:Key="Tia.PaneTab" TargetType="{x:Type RadioButton}">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="86"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.Text}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="Bd" Background="{StaticResource Tia.PanelBgAlt}"
                            BorderBrush="{StaticResource Tia.Border}" BorderThickness="1,1,0,1"
                            SnapsToDevicePixels="True">
                        <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tia.Brand}"/>
                            <Setter Property="Foreground" Value="{StaticResource Tia.TextOnBrand}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tia.BrandLight}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tia.PaletteGroupLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Tia.TextMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
