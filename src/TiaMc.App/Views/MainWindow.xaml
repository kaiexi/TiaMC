<Window x:Class="TiaMc.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:TiaMc.App.ViewModels"
        Title="TIA-MC 工程启动器"
        Icon="{DynamicResource App.Icon}"
        Height="880" Width="1480"
        MinHeight="620" MinWidth="1080"
        Background="{DynamicResource Tia.WindowBg}"
        Foreground="{DynamicResource Tia.Text}"
        FontFamily="Segoe UI" FontSize="12"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- title bar -->
            <RowDefinition Height="Auto" />   <!-- menu -->
            <RowDefinition Height="Auto" />   <!-- ribbon -->
            <RowDefinition Height="*" MinHeight="240" /> <!-- workspace -->
            <RowDefinition Height="Auto" />   <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ===================================================== title bar -->
        <Border Grid.Row="0" Background="{DynamicResource Tia.Brand}" Height="30"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- TIA draws a slim orange stripe on the very left edge -->
                <Border Grid.Column="0" Width="6" Height="30" Background="{DynamicResource Tia.Accent}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="TIA-MC" FontWeight="SemiBold" FontSize="12.5"
                               Foreground="{DynamicResource Tia.TextOnBrand}" />
                    <TextBlock Text="  -  " FontSize="11.5"
                               Foreground="{DynamicResource Tia.TextOnBrand}" Opacity="0.7" />
                    <TextBlock Text="{Binding RootPath}" FontSize="11.5"
                               Foreground="{DynamicResource Tia.TextOnBrand}" Opacity="0.9"
                               TextTrimming="CharacterEllipsis" MaxWidth="520" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding StateMessage}" Margin="18,0,0,0"
                           VerticalAlignment="Center" FontSize="11.5"
                           Foreground="{DynamicResource Tia.TextOnBrand}" Opacity="0.8"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Style="{StaticResource Tia.Button.Chrome}"
                            Click="Minimize_Click" ToolTip="最小化">
                        <Path Data="{StaticResource Chrome.Minimize}" Fill="{DynamicResource Tia.TextOnBrand}"
                              Width="10" Height="1" Stretch="None" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource Tia.Button.Chrome}"
                            Click="Maximize_Click" ToolTip="最大化 / 还原">
                        <Path x:Name="MaximizeIcon" Data="{StaticResource Chrome.Maximize}"
                              Fill="{DynamicResource Tia.TextOnBrand}" Width="10" Height="10" Stretch="None" />
                    </Button>
                    <Button Style="{StaticResource Tia.Button.ChromeClose}" Click="Close_Click" ToolTip="关闭">
                        <Path Data="{StaticResource Chrome.Close}" Fill="{DynamicResource Tia.TextOnBrand}"
                              Width="10" Height="10" Stretch="None" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================== menu -->
        <Menu Grid.Row="1" Style="{StaticResource Tia.Menu}">
            <MenuItem Header="项目(_P)" Style="{StaticResource Tia.MenuItem}">
                <MenuItem Header="刷新目录树" Command="{Binding RefreshCommand}" InputGestureText="F5" />
                <MenuItem Header="自动检测 Minecraft 目录..." Command="{Binding AutoDetectRootCommand}" />
                <MenuItem Header="打开目录" Style="{StaticResource Tia.MenuItem}">
                    <MenuItem Header="自动检测 Minecraft 目录..." Command="{Binding AutoDetectRootCommand}"
                              Style="{StaticResource Tia.MenuItem}" />
                    <Separator />
                    <MenuItem Header="游戏目录 (.minecraft)" Command="{Binding OpenGameFolderCommand}"
                              Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="配置目录 (config.json)" Command="{Binding OpenLogFolderCommand}"
                              Style="{StaticResource Tia.MenuItem}" />
                    <Separator />
                    <MenuItem Header="当前实例目录" Click="OpenInstanceFolder_Click"
                              Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="mods 目录" Click="OpenModsFolder_Click"
                              Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="saves 目录（存档）" Click="OpenSavesFolder_Click"
                              Style="{StaticResource Tia.MenuItem}" />
                </MenuItem>
                <MenuItem Header="复制路径" Style="{StaticResource Tia.MenuItem}">
                    <MenuItem Header="游戏目录" Click="CopyGamePath_Click" Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="当前实例路径" Click="CopyInstancePath_Click"
                              Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="当前实例 JSON" Click="CopyInstanceJson_Click"
                              Style="{StaticResource Tia.MenuItem}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="保存项目配置" Command="{Binding SaveConfigCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="导出诊断日志" Command="{Binding ExportDiagnosticsCommand}" />
                <Separator />
                <MenuItem Header="退出" Click="Close_Click" />
            </MenuItem>

            <MenuItem Header="编辑(_E)" Style="{StaticResource Tia.MenuItem}">
                <MenuItem Header="复制控制台内容" Command="{Binding CopyConsoleCommand}" />
                <MenuItem Header="清空控制台" Command="{Binding ClearConsoleCommand}" />
                <Separator />
                <MenuItem Header="复制启动命令行" Command="{Binding CopyCommandLineCommand}" />
                <MenuItem Header="清空诊断日志" Click="ClearLogs_Click" />
                <Separator />
                <MenuItem Header="导出诊断日志..." Command="{Binding ExportDiagnosticsCommand}" />
            </MenuItem>

            <MenuItem Header="视图(_V)" Style="{StaticResource Tia.MenuItem}">
                <MenuItem Header="工作区页面" Style="{StaticResource Tia.MenuItem}">
                    <MenuItem Header="实例概览" Click="SwitchTab_Click" Tag="0" Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="启动控制台" Click="SwitchTab_Click" Tag="1" Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="启动方案" Click="SwitchTab_Click" Tag="2" Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="诊断日志" Click="SwitchTab_Click" Tag="3" Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="版本管理" Click="SwitchTab_Click" Tag="4" Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="账户" Click="SwitchTab_Click" Tag="5" Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="模组" Click="SwitchTab_Click" Tag="6" Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="认证服务端" Click="SwitchTab_Click" Tag="7" Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="整合包（客户端 / 服务端）" Click="SwitchTab_Click" Tag="8" Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="资源下载（模组 / 资源包 / 光影）" Click="SwitchTab_Click" Tag="9" Style="{StaticResource Tia.MenuItem}" />
                    <Separator />
                    <MenuItem Header="诊断上次启动（日志 / 崩溃分析）" Click="Diagnose_Click" Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="以管理员身份重启" Click="RestartElevated_Click" Style="{StaticResource Tia.MenuItem}" />
                </MenuItem>
                <MenuItem Header="项目树" Style="{StaticResource Tia.MenuItem}">
                    <MenuItem Header="展开全部节点" Click="ExpandAll_Click" Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="折叠全部节点" Click="CollapseAll_Click" Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="刷新目录树" Command="{Binding RefreshCommand}"
                              Style="{StaticResource Tia.MenuItem}" />
                </MenuItem>
                <MenuItem Header="输出窗口" Style="{StaticResource Tia.MenuItem}">
                    <MenuItem Header="复制输出" Command="{Binding CopyConsoleCommand}"
                              Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="清空输出" Command="{Binding ClearConsoleCommand}"
                              Style="{StaticResource Tia.MenuItem}" />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="在线(_O)" Style="{StaticResource Tia.MenuItem}">
                <MenuItem Header="版本清单" Command="{Binding RefreshManifestCommand}" />
                <MenuItem Header="文件与下载" Style="{StaticResource Tia.MenuItem}">
                    <MenuItem Header="校验当前实例文件" Command="{Binding CheckFilesCommand}"
                              Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="补全缺失文件" Command="{Binding DownloadMissingCommand}"
                              Style="{StaticResource Tia.MenuItem}" />
                </MenuItem>
                <MenuItem Header="下载源" Style="{StaticResource Tia.MenuItem}">
                    <MenuItem Header="BMCLAPI 镜像（国内推荐）" IsCheckable="True"
                              IsChecked="{Binding UseBmclApi, Mode=TwoWay}" Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="Mojang 官方源" IsCheckable="True"
                              IsChecked="{Binding UseOfficialSource, Mode=TwoWay}" Style="{StaticResource Tia.MenuItem}" />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="选项(_T)" Style="{StaticResource Tia.MenuItem}">
                <MenuItem Header="Java 运行时" Style="{StaticResource Tia.MenuItem}">
                    <MenuItem Header="重新检测 Java" Command="{Binding DetectJavaCommand}"
                              Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="指定 java.exe..." Command="{Binding BrowseJavaCommand}"
                              Style="{StaticResource Tia.MenuItem}" />
                </MenuItem>
                <MenuItem Header="账户" Style="{StaticResource Tia.MenuItem}">
                    <MenuItem Header="新建离线账户" Command="{Binding AddOfflineAccountCommand}"
                              Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="Microsoft 正版登录" Command="{Binding AddMicrosoftAccountCommand}"
                              Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="刷新登录状态" Command="{Binding RefreshAccountCommand}"
                              Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="账户管理页面" Click="SwitchTab_Click" Tag="5"
                              Style="{StaticResource Tia.MenuItem}" />
                </MenuItem>
                <MenuItem Header="启动行为" Style="{StaticResource Tia.MenuItem}">
                    <MenuItem Header="启动时校验文件" IsCheckable="True" IsChecked="{Binding AutoCheckFiles, Mode=TwoWay}"
                              Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="自动下载缺失文件" IsCheckable="True"
                              IsChecked="{Binding AutoDownloadMissing, Mode=TwoWay}" Style="{StaticResource Tia.MenuItem}" />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="工具(_L)" Style="{StaticResource Tia.MenuItem}">
                <MenuItem Header="生成启动方案" Command="{Binding BuildPlanCommand}" />
                <MenuItem Header="实例操作" Style="{StaticResource Tia.MenuItem}">
                    <MenuItem Header="设为当前实例" Click="SetActiveInstance_Click"
                              Style="{StaticResource Tia.MenuItem}" />
                    <MenuItem Header="打开实例目录" Click="OpenInstanceFolder_Click"
                              Style="{StaticResource Tia.MenuItem}" />
                </MenuItem>
                <MenuItem Header="导出诊断日志" Command="{Binding ExportDiagnosticsCommand}" />
                <MenuItem Header="打开配置目录" Command="{Binding OpenLogFolderCommand}" />
            </MenuItem>

            <MenuItem Header="帮助(_H)" Style="{StaticResource Tia.MenuItem}">
                <MenuItem Header="关于 TIA-MC" Click="About_Click" />
                <MenuItem Header="内核参考: ColorMC" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- ================================================= TIA style toolbar -->
        <Border Grid.Row="2" Background="{DynamicResource Tia.RibbonBg}"
                BorderBrush="{DynamicResource Tia.Border}" BorderThickness="0,1,0,1">
            <Grid Margin="4,3,4,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 保存项目 / 编译 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource Tia.Button.Tool}" Command="{Binding SaveConfigCommand}"
                            ToolTip="保存项目组态 (config.json)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Save}" Fill="{DynamicResource Tia.Brand}"
                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="{StaticResource ToolLabel.Save}" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tia.Button.Tool}" Command="{Binding RefreshCommand}"
                            ToolTip="刷新目录树">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Refresh}" Fill="{DynamicResource Tia.Brand}"
                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="{StaticResource ToolLabel.Refresh}" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border Grid.Column="1" Width="1"
                        Background="{DynamicResource Tia.Border}" Margin="5,2" />

                <!-- 编译并下载 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource Tia.Button.Tool}" Command="{Binding CheckFilesCommand}"
                            ToolTip="校验库 / 资源 / 客户端 Jar">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Compile}" Fill="{DynamicResource Tia.Brand}"
                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="{StaticResource ToolLabel.Check}" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tia.Button.Tool}" Command="{Binding DownloadMissingCommand}"
                            ToolTip="从下载源补全缺失文件">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Download}" Fill="{DynamicResource Tia.Brand}"
                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="{StaticResource ToolLabel.Download}" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border Grid.Column="3" Width="1"
                        Background="{DynamicResource Tia.Border}" Margin="5,2" />

                <!-- 在线 / 离线 -->
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Style="{StaticResource Tia.Button.Tool}" Command="{Binding LaunchCommand}"
                            ToolTip="启动游戏（转至在线）">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Play}" Fill="{DynamicResource Tia.Run}"
                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="{StaticResource ToolLabel.Online}" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tia.Button.Tool}" Command="{Binding StopCommand}"
                            ToolTip="结束游戏进程（转至离线）">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Stop}" Fill="{DynamicResource Tia.Error}"
                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="{StaticResource ToolLabel.Offline}" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tia.Button.Tool}" Command="{Binding RefreshManifestCommand}"
                            ToolTip="获取在线版本清单">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Online}" Fill="{DynamicResource Tia.Brand}"
                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="{StaticResource ToolLabel.Manifest}" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Web 界面：把 Web 版（浏览器窗口 + 本地 HTTP 服务）当作启动器拉起来 -->
                    <Button Style="{StaticResource Tia.Button.Tool}" Click="OpenWebUi_Click"
                            ToolTip="打开 Web 界面（TiaMC-Web.exe：浏览器窗口里操作同一套内核）">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Online}" Fill="{DynamicResource Tia.Run}"
                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="Web 界面" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- authentication server switch: starts/stops the Yggdrasil server -->
                    <Border Background="{DynamicResource Tia.Border}" Width="1" Margin="7,4" />
                    <TextBlock Text="认证服务端" Style="{StaticResource Tia.MutedText}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ToggleButton Style="{StaticResource Tia.Switch}" VerticalAlignment="Center"
                                  IsChecked="{Binding YggServerOn, Mode=OneWay}"
                                  Click="YggSwitch_Click"
                                  ToolTip="{Binding YggServerSwitchTooltip}" />
                    <TextBlock Text="{Binding YggServerStateText}" Style="{StaticResource Tia.MutedText}"
                               VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
                <Border Grid.Column="5" Width="1"
                        Background="{DynamicResource Tia.Border}" Margin="5,2" />

                <!-- 运行状态 -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{DynamicResource Tia.Run}"
                             ToolTip="{Binding StateMessage}" />
                    <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="6,0,0,0" />
                    <TextBlock Text="{Binding DetailVersion}" Style="{StaticResource Tia.MutedText}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Text="{Binding MemoryText}" Style="{StaticResource Tia.MutedText}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <Border Grid.Column="7" Width="1" Background="{DynamicResource Tia.Border}" Margin="5,2" />

                <!-- 在项目中搜索 -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="在项目中搜索" Style="{StaticResource Tia.MutedText}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="190" Text="{Binding TreeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按实例名称 / 装载器过滤项目树" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================================================== workspace -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" MinWidth="200" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="360" MinWidth="260" />
                <ColumnDefinition Width="22" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="26" />
                <RowDefinition Height="*" MinHeight="200" />
                <RowDefinition Height="4" />
                <RowDefinition Height="230" MinHeight="90" />
            </Grid.RowDefinitions>

            <!-- breadcrumb bar: project > instance > object (TIA editor header) -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5"
                    Background="{DynamicResource Tia.PanelBgAlt}"
                    BorderBrush="{DynamicResource Tia.Border}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                    <TextBlock Text="项目" Style="{StaticResource Tia.BreadcrumbRoot}" VerticalAlignment="Center" />
                    <TextBlock Text="▸" Style="{StaticResource Tia.BreadcrumbSeparator}" />
                    <TextBlock Text="设备和网络" Style="{StaticResource Tia.BreadcrumbItem}" />
                    <TextBlock Text="▸" Style="{StaticResource Tia.BreadcrumbSeparator}" />
                    <TextBlock Text="{Binding DetailVersion}" Style="{StaticResource Tia.BreadcrumbCurrent}" />
                    <TextBlock Text="▸" Style="{StaticResource Tia.BreadcrumbSeparator}" />
                    <TextBlock Text="{Binding StateText}" Style="{StaticResource Tia.MutedText}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- project tree -->
            <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="0" Background="{DynamicResource Tia.PanelBg}"
                    BorderBrush="{DynamicResource Tia.Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Tia.DockHeader}">
                        <Grid>
                            <TextBlock Text="项目树" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DetailVersion}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Opacity="0.8" FontSize="11" />
                        </Grid>
                    </Border>
                    <TreeView x:Name="ProjectTree" ItemsSource="{Binding Navigation}"
                              Style="{StaticResource Tia.TreeView}"
                              Loaded="ProjectTree_Loaded"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectedItemChanged="ProjectTree_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource Tia.TreeViewItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:TreeNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                    <Path Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"
                                          Fill="{DynamicResource Tia.Brand}" Width="14" Height="14"
                                          Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Subtitle}" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Style="{StaticResource Tia.MutedText}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>

                        <!-- second level menu: right click a node in the project tree -->
                        <TreeView.ContextMenu>
                            <ContextMenu Style="{StaticResource Tia.ContextMenu}">
                                <MenuItem Header="启动该实例" Command="{Binding LaunchCommand}"
                                          Style="{StaticResource Tia.MenuItem}" />
                                <MenuItem Header="校验文件完整性" Command="{Binding CheckFilesCommand}"
                                          Style="{StaticResource Tia.MenuItem}" />
                                <MenuItem Header="补全缺失文件" Command="{Binding DownloadMissingCommand}"
                                          Style="{StaticResource Tia.MenuItem}" />
                                <Separator />
                                <MenuItem Header="打开工作区" Style="{StaticResource Tia.MenuItem}">
                                    <MenuItem Header="实例概览" Click="SwitchTab_Click" Tag="0"
                                              Style="{StaticResource Tia.MenuItem}" />
                                    <MenuItem Header="启动控制台" Click="SwitchTab_Click" Tag="1"
                                              Style="{StaticResource Tia.MenuItem}" />
                                    <MenuItem Header="启动方案" Click="SwitchTab_Click" Tag="2"
                                              Style="{StaticResource Tia.MenuItem}" />
                                    <MenuItem Header="诊断日志" Click="SwitchTab_Click" Tag="3"
                                              Style="{StaticResource Tia.MenuItem}" />
                                </MenuItem>
                                <MenuItem Header="设置" Style="{StaticResource Tia.MenuItem}">
                                    <MenuItem Header="刷新目录树" Command="{Binding RefreshCommand}"
                                              Style="{StaticResource Tia.MenuItem}" />
                                    <MenuItem Header="展开全部" Click="ExpandAll_Click"
                                              Style="{StaticResource Tia.MenuItem}" />
                                    <MenuItem Header="折叠全部" Click="CollapseAll_Click"
                                              Style="{StaticResource Tia.MenuItem}" />
                                    <Separator />
                                    <MenuItem Header="重新检测 Java" Command="{Binding DetectJavaCommand}"
                                              Style="{StaticResource Tia.MenuItem}" />
                                    <MenuItem Header="打开游戏目录" Command="{Binding OpenGameFolderCommand}"
                                              Style="{StaticResource Tia.MenuItem}" />
                                    <MenuItem Header="打开配置目录" Command="{Binding OpenLogFolderCommand}"
                                              Style="{StaticResource Tia.MenuItem}" />
                                </MenuItem>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Style="{StaticResource Tia.Splitter}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- workspace tabs -->
            <!-- 标签页只占工作区那一行，否则内容会延伸到输出窗口下面被遮住 -->
            <TabControl Grid.Row="1" Grid.Column="2" Style="{StaticResource Tia.TabControl}"
                        SelectedIndex="{Binding WorkspaceTab, Mode=TwoWay}">
                <!-- ============ overview -->
                <TabItem Header="概览" Style="{StaticResource Tia.TabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource Tia.PanelBg}">
                        <StackPanel Margin="14">
                            <TextBlock Text="实例概览" Style="{StaticResource Tia.SectionHeader}" FontSize="15" />
                            <TextBlock Margin="0,2,0,12" Style="{StaticResource Tia.MutedText}"
                                       Text="选择左侧项目树中的 Minecraft 实例，此处显示该实例的组态与运行状态。" />

                            <Border Style="{StaticResource Tia.Card}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" MinWidth="140" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" MinWidth="120" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Tia.Label}" Text="版本 ID" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Tia.TextStrong}" Text="{Binding DetailVersion}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Tia.Label}" Text="装载器" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding DetailLoader}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Tia.Label}" Text="版本类型" Margin="0,6,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailType}" Margin="0,6,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Tia.Label}" Text="Java 需求" Margin="0,6,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DetailJavaRequired}" Margin="0,6,0,0" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Tia.Label}" Text="库条目" Margin="0,6,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailLibraryCount}" Margin="0,6,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Tia.Label}" Text="文件状态" Margin="0,6,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding DetailStatus}" Margin="0,6,0,0"
                                               Foreground="{DynamicResource Tia.Brand}" FontWeight="SemiBold" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Tia.Label}" Text="继承链" Margin="0,6,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding DetailChain}"
                                               Margin="0,6,0,0" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Tia.Label}" Text="校验结果" Margin="0,6,0,0" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding DetailCheckSummary}"
                                               Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource Tia.MutedText}" />
                                </Grid>
                            </Border>

                            <TextBlock Text="快速操作" Style="{StaticResource Tia.SectionHeader}" Margin="0,4,0,4" />
                            <WrapPanel>
                                <Button Style="{StaticResource Tia.Button.Primary}" Content="启动游戏"
                                        Command="{Binding LaunchCommand}" Margin="0,0,8,8" Padding="18,6" />
                                <Button Style="{StaticResource Tia.Button}" Content="校验文件"
                                        Command="{Binding CheckFilesCommand}" Margin="0,0,8,8" />
                                <Button Style="{StaticResource Tia.Button}" Content="补全缺失文件"
                                        Command="{Binding DownloadMissingCommand}" Margin="0,0,8,8" />
                                <Button Style="{StaticResource Tia.Button}" Content="停止游戏"
                                        Command="{Binding StopCommand}" Margin="0,0,8,8" />
                                <Button Style="{StaticResource Tia.Button}" Content="生成启动方案"
                                        Command="{Binding BuildPlanCommand}" Margin="0,0,8,8" />
                            </WrapPanel>

                            <TextBlock Text="启动方案摘要" Style="{StaticResource Tia.SectionHeader}" Margin="0,10,0,4" />
                            <Border Style="{StaticResource Tia.Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DetailPlanSummary}" Style="{StaticResource Tia.TextStrong}" />
                                    <TextBlock Text="{Binding MainClassText}" Style="{StaticResource Tia.MutedText}" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding NativesText}" Style="{StaticResource Tia.MutedText}" Margin="0,2,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============ console -->
                <TabItem Header="控制台" Style="{StaticResource Tia.TabItem}">
                    <DockPanel Background="{DynamicResource Tia.PanelBg}">
                        <Border DockPanel.Dock="Top" Style="{StaticResource Tia.Toolbar}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Tia.Button.Tool}" Command="{Binding CopyConsoleCommand}"
                                        Content="复制" ToolTip="复制全部输出" />
                                <Button Style="{StaticResource Tia.Button.Tool}" Command="{Binding ClearConsoleCommand}"
                                        Content="清空" />
                                <Separator Style="{StaticResource Tia.Separator}" Margin="6,2" />
                                <CheckBox Content="自动滚动" VerticalAlignment="Center"
                                          IsChecked="{Binding AutoScrollConsole, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource Tia.MutedText}" VerticalAlignment="Center"
                                           Margin="12,0,0,0" Text="{Binding Console.LineCount, StringFormat=共 {0} 行}" />
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="ConsoleBox" Style="{StaticResource Tia.Console}"
                                 Text="{Binding Console.Text, Mode=OneWay}"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </DockPanel>
                </TabItem>

                <!-- ============ plan -->
                <TabItem Header="启动方案" Style="{StaticResource Tia.TabItem}">
                    <DockPanel Background="{DynamicResource Tia.PanelBg}">
                        <Border DockPanel.Dock="Top" Style="{StaticResource Tia.Toolbar}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Tia.Button.Tool}" Content="重新生成"
                                        Command="{Binding BuildPlanCommand}" />
                                <Button Style="{StaticResource Tia.Button.Tool}" Content="复制命令行"
                                        Command="{Binding CopyCommandLineCommand}" />
                                <TextBlock Style="{StaticResource Tia.MutedText}" VerticalAlignment="Center"
                                           Margin="12,0,0,0" Text="{Binding DetailPlanSummary}" />
                            </StackPanel>
                        </Border>
                        <DataGrid EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ItemsSource="{Binding PlanRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="{DynamicResource Tia.PanelBg}"
                                  RowBackground="{DynamicResource Tia.ContentBg}"
                                  BorderThickness="0" RowHeight="22"
                                  AlternatingRowBackground="{DynamicResource Tia.RowAlt}"
                                  CanUserAddRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="170" />
                                <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="100" />
                                <DataGridTextColumn Header="内容" Binding="{Binding Value}" Width="*" />
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- ============ diagnostics log -->
                <TabItem Header="日志" Style="{StaticResource Tia.TabItem}">
                    <Grid Background="{DynamicResource Tia.PanelBg}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="90" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="235" MinHeight="150" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Tia.Toolbar}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="级别" Style="{StaticResource Tia.Label}" VerticalAlignment="Center" />
                                <ComboBox Width="110" ItemsSource="{Binding LogLevels}"
                                          SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}" />
                                <Button Style="{StaticResource Tia.Button.Tool}" Content="清空" Margin="8,0,0,0"
                                        Click="ClearLogs_Click" />
                                <Separator Style="{StaticResource Tia.Separator}" Margin="6,2" />
                                <Button Style="{StaticResource Tia.Button.Primary}" Content="诊断上次启动"
                                        Click="Diagnose_Click"
                                        ToolTip="分析本次/上次游戏日志与 crash-reports，给出原因、建议与疑似模组（HMCL 式崩溃分析）" />
                                <Separator Style="{StaticResource Tia.Separator}" Margin="6,2" />
                                <Button Style="{StaticResource Tia.Button.ServerPack}" Content="快速导出（推荐）"
                                        Click="QuickExport_Click"
                                        ToolTip="不用选路径：导出到日志目录并把路径复制到剪贴板；没有写入权限时自动改存到可写目录" />
                                <Button Style="{StaticResource Tia.Button.Tool}" Content="导出日志…"
                                        Click="ExportLog_Click"
                                        ToolTip="完整导出：启动器日志 + 用户操作记录 + Minecraft 的 latest.log / debug.log / 崩溃报告 / hs_err 一起写进一个文件" />
                                <Button Style="{StaticResource Tia.Button.Primary}" Content="导出诊断包…"
                                        Click="ExportBundle_Click"
                                        ToolTip="打包成 zip：启动器日志、MC 日志与崩溃报告、系统信息、脱敏后的配置、模组清单" />
                                <Button Style="{StaticResource Tia.Button.Tool}" Content="打开日志文件夹"
                                        Click="OpenLogFolder_Click" />
                                <Button Style="{StaticResource Tia.Button.Tool}" Content="复制全部"
                                        Click="CopyLog_Click" />
                            </StackPanel>
                        </Border>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" Style="{StaticResource Tia.ListBox}"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TimeText}" Width="86"
                                                   Style="{StaticResource Tia.MutedText}" />
                                        <TextBlock Text="{Binding LevelText}" Width="46" FontWeight="SemiBold"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}" />
                                        <TextBlock Text="{Binding Source}" Width="90"
                                                   Style="{StaticResource Tia.MutedText}" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- draggable divider: log above, diagnosis below -->
                        <GridSplitter Grid.Row="2" Style="{StaticResource Tia.Splitter.H}" />

                        <Border Grid.Row="3" Background="{DynamicResource Tia.PanelBg}"
                                BorderBrush="{DynamicResource Tia.Border}" BorderThickness="0,1,0,0"
                                Padding="10,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 结论文字占满整行，不再被挤成窄条 -->
                                <DockPanel Grid.Row="0" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="诊断结论"
                                               Style="{StaticResource Tia.SectionHeader}" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding DiagnosisReportPath}"
                                               Style="{StaticResource Tia.MutedText}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>

                                <Border Grid.Row="1" Margin="0,4,0,0" Padding="8,6"
                                        Background="{DynamicResource Tia.ContentBg}"
                                        BorderBrush="{DynamicResource Tia.Border}" BorderThickness="1">
                                    <TextBlock Text="{Binding DiagnosisSummary}" TextWrapping="Wrap"
                                               Style="{StaticResource Tia.TextStrong}" />
                                </Border>

                                <Grid Grid.Row="2" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="320" />
                                    </Grid.ColumnDefinitions>

                                    <ListBox Grid.Column="0" ItemsSource="{Binding DiagnosisHints}"
                                             Style="{StaticResource Tia.ListBox}"
                                             BorderThickness="0" Background="Transparent" Margin="0,0,10,0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                               Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                                    <TextBlock Text="{Binding Advice}" TextWrapping="Wrap"
                                                               Style="{StaticResource Tia.MutedText}" />
                                                    <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap"
                                                               Style="{StaticResource Tia.MutedText}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="疑似模组 / 堆栈关键词" Style="{StaticResource Tia.SectionHeader}" />
                                        <TextBlock Text="{Binding DiagnosisSuspects}" TextWrapping="Wrap"
                                                   Style="{StaticResource Tia.MutedText}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding DiagnosisKeywords}" TextWrapping="Wrap"
                                                   Style="{StaticResource Tia.MutedText}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ============ version manager -->
                <TabItem Header="版本" Style="{StaticResource Tia.TabItem}">
                    <Grid Background="{DynamicResource Tia.PanelBg}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="70" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="70" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Tia.Toolbar}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Tia.Button.Tool}" Content="刷新本地版本"
                                        Command="{Binding RefreshCommand}" />
                                <Button Style="{StaticResource Tia.Button.Tool}" Content="获取在线版本清单"
                                        Command="{Binding RefreshManifestCommand}" />
                                <Separator Style="{StaticResource Tia.Separator}" Margin="6,2" />
                                <Button Style="{StaticResource Tia.Button.Primary}" Content="下载并安装选中版本"
                                        Command="{Binding InstallVersionCommand}"
                                        CommandParameter="{Binding SelectedRemoteVersion}" />
                                <TextBlock Style="{StaticResource Tia.MutedText}" VerticalAlignment="Center"
                                           Margin="12,0,0,0" Text="{Binding RemoteLatestText}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="1" Text="已安装实例" Style="{StaticResource Tia.SectionHeader}" Margin="10,6,0,4" />

                        <DataGrid EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Grid.Row="2" ItemsSource="{Binding VersionChoices}" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column" RowHeight="22"
                                  BorderThickness="0" Background="{DynamicResource Tia.PanelBg}"
                                  RowBackground="{DynamicResource Tia.ContentBg}"
                                  AlternatingRowBackground="{DynamicResource Tia.RowAlt}"
                                  SelectionChanged="VersionTable_SelectionChanged"
                                  SelectedItem="{Binding ActiveChoice, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="版本 ID" Binding="{Binding Id}" Width="*" />
                                <DataGridTextColumn Header="装载器" Binding="{Binding Loader}" Width="120" />
                            </DataGrid.Columns>
                            <!-- second level menu: right click an installed instance -->

                        </DataGrid>

                        <!-- draggable divider between installed and online versions -->
                        <GridSplitter Grid.Row="3" Style="{StaticResource Tia.Splitter.H}" />

                        <Border Grid.Row="4" Background="{DynamicResource Tia.PanelBg}" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="在线版本（双击安装）" Style="{StaticResource Tia.SectionHeader}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RemoteTypeSummary}" Style="{StaticResource Tia.MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <TextBlock Text="只看" Style="{StaticResource Tia.Label}" VerticalAlignment="Center" Margin="14,0,4,0" />
                                <ComboBox Width="150" ItemsSource="{Binding RemoteTypeFilters}" SelectedItem="{Binding RemoteTypeFilter, Mode=TwoWay}" ToolTip="正式版与测试版（快照）分开显示" />
                                <TextBlock Text="搜索" Style="{StaticResource Tia.Label}" VerticalAlignment="Center" Margin="10,0,4,0" />
                                <TextBox Width="150" Text="{Binding RemoteSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="按版本号过滤，例如 1.20" />
                                <TextBlock Text="{Binding RemoteFilterText}" Style="{StaticResource Tia.MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </Border>

                        <DataGrid EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Grid.Row="5" ItemsSource="{Binding FilteredRemoteVersions}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" RowHeight="22" BorderThickness="0"
                                  Background="{DynamicResource Tia.PanelBg}"
                                  RowBackground="{DynamicResource Tia.ContentBg}"
                                  AlternatingRowBackground="{DynamicResource Tia.RowAlt}"
                                  SelectedItem="{Binding SelectedRemoteVersion, Mode=TwoWay}"
                                  MouseDoubleClick="RemoteVersions_MouseDoubleClick">
                                <DataGrid.ContextMenu>
                                    <ContextMenu Style="{StaticResource Tia.ContextMenu}">
                                        <MenuItem Header="下载并安装此版本" Click="InstallRemote_Click"
                                                  Style="{StaticResource Tia.MenuItem}" />
                                        <Separator />
                                        <MenuItem Header="复制版本 ID" Click="CopyRemoteId_Click"
                                                  Style="{StaticResource Tia.MenuItem}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <!-- 正式版 / 测试版（快照）用不同颜色区分 -->
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSnapshot}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Tia.ServerPackRow}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Tia.ServerPackText}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLegacy}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Tia.TextMuted}" />
                                            </DataTrigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Tia.Selection}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="版本" Binding="{Binding Id}" Width="*" />
                                    <DataGridTemplateColumn Header="类型" Width="170">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border x:Name="TypeBadge" Padding="5,1" CornerRadius="2"
                                                            Background="{DynamicResource Tia.Brand}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="10.5" />
                                                    </Border>
                                                    <TextBlock Text="{Binding TypeText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSnapshot}" Value="True">
                                                        <Setter TargetName="TypeBadge" Property="Background"
                                                                Value="{DynamicResource Tia.ServerPackBadge}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLegacy}" Value="True">
                                                        <Setter TargetName="TypeBadge" Property="Background"
                                                                Value="{DynamicResource Tia.ClientPackBadge}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="发布时间" Binding="{Binding ReleaseTime}" Width="110" />
                                    <DataGridTemplateColumn Header="状态" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Installed, Converter={StaticResource InstalledText}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ============ accounts -->
                <TabItem Header="账户" Style="{StaticResource Tia.TabItem}">
                    <Grid Background="{DynamicResource Tia.PanelBg}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="0" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource Tia.Toolbar}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 账户选择（与账户管理集成在同一块里） -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="账户选择与管理"
                                               Style="{StaticResource Tia.Label}" VerticalAlignment="Center" />
                                    <ComboBox Width="200" Margin="6,0,0,0" ItemsSource="{Binding Accounts}"
                                              SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                              DisplayMemberPath="Display" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                    <Button Style="{StaticResource Tia.Button.Tool}" Content="新建离线账户"
                                            Command="{Binding AddOfflineAccountCommand}" />
                                    <Button Style="{StaticResource Tia.Button.Tool}" Content="Microsoft 正版登录"
                                            Command="{Binding AddMicrosoftAccountCommand}" />
                                    <Separator Style="{StaticResource Tia.Separator}" Margin="6,2" />
                                    <Button Style="{StaticResource Tia.Button.Tool}" Content="刷新登录状态"
                                            Command="{Binding RefreshAccountCommand}" />
                                    <Button Style="{StaticResource Tia.Button.Tool}" Content="删除账户"
                                            Command="{Binding RemoveAccountCommand}" />
                                    <TextBlock Text="{Binding AccountSummary}" Style="{StaticResource Tia.MutedText}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Grid.Row="1" ItemsSource="{Binding Accounts}"
                                  SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" RowHeight="34" BorderThickness="0"
                                  MaxHeight="280" VerticalAlignment="Top"
                                  Background="{DynamicResource Tia.PanelBg}"
                                  RowBackground="{DynamicResource Tia.ContentBg}"
                                  AlternatingRowBackground="{DynamicResource Tia.RowAlt}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="皮肤" Width="48">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Width="26" Height="26" Margin="4,0" Stretch="Fill"
                                                   Source="{Binding SkinSource, Converter={StaticResource SkinHead}}"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="玩家名称" Binding="{Binding Name}" Width="170" />
                                <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="80" />
                                <DataGridTextColumn Header="UUID" Binding="{Binding Uuid}" Width="*" />
                                <DataGridTextColumn Header="游戏许可" Binding="{Binding OwnsGame}" Width="80" />
                                <DataGridTextColumn Header="登录时间" Binding="{Binding LastLoginUtc}" Width="160" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- leftover space: guidance instead of a white void -->
                        <!-- 皮肤管理：直接放在账户页里（右侧属性面板太窄） -->
                        <Grid Grid.Row="2" Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="240" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="430" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource Tia.PanelBg}" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Tia.MutedText}" TextWrapping="Wrap"
                                               Text="离线账户：只需要一个名称，UUID 由名称推导（OfflinePlayer 规则），适合单机与局域网。" />
                                    <TextBlock Style="{StaticResource Tia.MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="Microsoft 正版账户：点击「Microsoft 正版登录」，在浏览器打开 microsoft.com/link 输入设备代码即可；令牌到期后启动游戏前会自动刷新。" />
                                    <TextBlock Text="当前选中的账户" Style="{StaticResource Tia.SectionHeader}" Margin="0,14,0,0" />
                                    <TextBlock Text="{Binding AccountSummary}" Style="{StaticResource Tia.TextStrong}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding AccountTokenText}" Style="{StaticResource Tia.MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Text="皮肤" Style="{StaticResource Tia.SectionHeader}" Margin="0,14,0,0" />
                                    <TextBlock Style="{StaticResource Tia.MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="离线账户也能换皮肤：本地 PNG、模板生成（纯色/条纹/渐变/棋盘格/按名字），或从皮肤站获取（mc-heads / Minotar / Crafatar / LittleSkin 等 Blessing Skin 站点、任意图片链接）。" />
                                    <TextBlock Style="{StaticResource Tia.MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="★ 建议使用正版账户登录" />
                                </StackPanel>
                            </Border>

                            <GridSplitter Grid.Column="1" Style="{StaticResource Tia.Splitter}" />

                            <Border Grid.Column="2" Background="{DynamicResource Tia.PanelBg}"
                                    BorderBrush="{DynamicResource Tia.Border}" BorderThickness="1" Margin="0,8,10,8"
                                    Padding="12,10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="账户皮肤" Style="{StaticResource Tia.SectionHeader}" />
                                        <!-- 实时预览：改模板/颜色立刻更新，可选视角与缩放 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Background="{DynamicResource Tia.PanelBgAlt}"
                                                    BorderBrush="{DynamicResource Tia.Border}" BorderThickness="1" Padding="6">
                                                <Image Source="{Binding SkinPreviewBody}" Stretch="None"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" Width="250">
                                                <TextBlock Text="视角" Style="{StaticResource Tia.Label}" />
                                                <ComboBox ItemsSource="{Binding SkinViews}"
                                                          SelectedItem="{Binding SkinView, Mode=TwoWay}" Margin="0,2,0,0" />
                                                <TextBlock Text="缩放" Style="{StaticResource Tia.Label}" Margin="0,6,0,0" />
                                                <ComboBox ItemsSource="{Binding SkinZooms}"
                                                          SelectedItem="{Binding SkinZoom, Mode=TwoWay}" Margin="0,2,0,0" />
                                                <Border Width="56" Height="56" Margin="0,8,0,0" HorizontalAlignment="Left"
                                                        Background="{DynamicResource Tia.PanelBgAlt}"
                                                        BorderBrush="{DynamicResource Tia.Border}" BorderThickness="1">
                                                    <Image Source="{Binding SkinPreviewHead}" Stretch="Fill"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Width="72" Height="72" BorderBrush="{DynamicResource Tia.Border}"
                                                    BorderThickness="1" Background="{DynamicResource Tia.PanelBgAlt}">
                                                <Image Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                       Source="{Binding SkinAvatarSource, Converter={StaticResource SkinHead}}" />
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" Width="300">
                                                <TextBlock Text="{Binding SkinStatus}" Style="{StaticResource Tia.MutedText}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SelectedAccount.SkinPath}"
                                                           Style="{StaticResource Tia.MutedText}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Style="{StaticResource Tia.Button}" Content="选择皮肤文件…" Click="PickSkin_Click" />
                                            <Button Style="{StaticResource Tia.Button.Primary}" Content="生成并应用" Margin="6,0,0,0"
                                                    Click="GenerateSkin_Click" />
                                            <Button Style="{StaticResource Tia.Button}" Content="随机" Margin="6,0,0,0"
                                                    Click="RandomSkin_Click" />
                                            <Button Style="{StaticResource Tia.Button}" Content="清除" Margin="6,0,0,0"
                                                    Click="ClearSkin_Click" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="模板" Style="{StaticResource Tia.Label}" VerticalAlignment="Center" />
                                            <ComboBox Width="110" Margin="6,0,0,0" ItemsSource="{Binding SkinTemplates}"
                                                      SelectedItem="{Binding SkinTemplate, Mode=TwoWay}" />
                                            <TextBlock Text="主色" Style="{StaticResource Tia.Label}" VerticalAlignment="Center" Margin="10,0,4,0" />
                                            <ComboBox Width="100" ItemsSource="{Binding SkinColors}"
                                                      SelectedItem="{Binding SkinPrimary, Mode=TwoWay}" />
                                            <TextBlock Text="副色" Style="{StaticResource Tia.Label}" VerticalAlignment="Center" Margin="10,0,4,0" />
                                            <ComboBox Width="100" ItemsSource="{Binding SkinColors}"
                                                      SelectedItem="{Binding SkinSecondary, Mode=TwoWay}" />
                                        </StackPanel>
                                        <TextBlock Text="外部皮肤站" Style="{StaticResource Tia.Label}" Margin="0,12,0,2" />
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox Width="170" ItemsSource="{Binding SkinSites}"
                                                      SelectedItem="{Binding SkinSite, Mode=TwoWay}" />
                                            <TextBox Width="150" Margin="6,0,0,0"
                                                     Text="{Binding SkinQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="玩家名 / UUID / 图片链接；留空用当前账户名" />
                                            <Button Style="{StaticResource Tia.Button.ServerPack}" Content="获取皮肤" Margin="6,0,0,0"
                                                    Click="FetchSkin_Click" />
                                        </StackPanel>
                                        <Button Style="{StaticResource Tia.Button.Tool}" Content="同步到认证服务端（游戏内可见）"
                                                Margin="0,10,0,0" HorizontalAlignment="Left" Click="PushSkin_Click" />

                                        <Separator Style="{StaticResource Tia.Separator}" Margin="0,10" />

                                        <!-- 外置登录：部分服务器要求皮肤站登录，启动时自动挂 authlib-injector -->
                                        <TextBlock Text="外置登录（第三方皮肤站 / 认证服务器）" Style="{StaticResource Tia.SectionHeader}" />
                                        <TextBlock Text="{Binding YggLoginStatus}" Style="{StaticResource Tia.MutedText}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="服务器" Style="{StaticResource Tia.Label}" VerticalAlignment="Center" />
                                            <ComboBox Width="200" Margin="6,0,0,0" IsEditable="True"
                                                      ItemsSource="{Binding AuthServers}"
                                                      SelectedItem="{Binding YggLoginServer, Mode=TwoWay}"
                                                      ToolTip="皮肤站地址，例如 https://littleskin.cn（会自动补 /api/yggdrasil）" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBox Width="140" Text="{Binding YggLoginEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="皮肤站登录邮箱" />
                                            <TextBox Width="140" Margin="6,0,0,0"
                                                     Text="{Binding YggLoginPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="皮肤站登录密码（只用于换取令牌，不会保存明文）" />
                                            <Button Style="{StaticResource Tia.Button.Primary}" Content="外置登录" Margin="6,0,0,0"
                                                    Click="YggLogin_Click" />
                                            <Button Style="{StaticResource Tia.Button}" Content="刷新令牌" Margin="6,0,0,0"
                                                    Click="YggRefresh_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ============ mods -->
                <TabItem Header="模组" Style="{StaticResource Tia.TabItem}">
                    <Grid Background="{DynamicResource Tia.PanelBg}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="80" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" MinHeight="120" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Tia.Toolbar}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Tia.Button.Tool}" Command="{Binding RefreshModsCommand}"
                                        Content="{StaticResource ModLabel.Refresh}" ToolTip="重新扫描 mods 目录" />
                                <Button Style="{StaticResource Tia.Button.Tool}" Command="{Binding ImportModsCommand}"
                                        Content="{StaticResource ModLabel.Import}" ToolTip="从本地 jar 文件安装模组" />
                                <Button Style="{StaticResource Tia.Button.Tool}" Command="{Binding ToggleModCommand}"
                                        Content="{StaticResource ModLabel.Toggle}" ToolTip="启用 / 停用选中模组（改扩展名）" />
                                <Button Style="{StaticResource Tia.Button.Tool}" Command="{Binding DeleteModCommand}"
                                        Content="{StaticResource ModLabel.Delete}" ToolTip="从磁盘删除选中模组" />
                                <Separator Style="{StaticResource Tia.Separator}" Margin="6,2" />
                                <Button Style="{StaticResource Tia.Button.Tool}" Command="{Binding OpenModsFolderCommand}"
                                        Content="{StaticResource ModLabel.Folder}" />
                                <Button Style="{StaticResource Tia.Button.Tool}" Command="{Binding BrowseModsFolderCommand}"
                                        Content="{StaticResource ModLabel.Browse}" ToolTip="指定其他 mods 目录" />
                                <TextBlock Text="搜索" Style="{StaticResource Tia.MutedText}" VerticalAlignment="Center"
                                           Margin="12,0,6,0" />
                                <TextBox Width="180" Text="{Binding ModSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="按名称 / Mod ID / 文件名 / 作者过滤" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="{DynamicResource Tia.PanelBg}"
                                BorderBrush="{DynamicResource Tia.Border}" BorderThickness="0,0,0,1"
                                Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ModsSummary}" Style="{StaticResource Tia.TextStrong}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ModsPath}" Style="{StaticResource Tia.MutedText}"
                                           VerticalAlignment="Center" Margin="14,0,0,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="520" />
                            </StackPanel>
                        </Border>

                        <DataGrid EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Grid.Row="2" ItemsSource="{Binding FilteredMods}"
                                  SelectedItem="{Binding SelectedMod, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column" RowHeight="22" BorderThickness="0"
                                  MinHeight="80"
                                  Background="{DynamicResource Tia.PanelBg}"
                                  RowBackground="{DynamicResource Tia.ContentBg}"
                                  AlternatingRowBackground="{DynamicResource Tia.RowAlt}"
                                  MouseDoubleClick="Mods_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu Style="{StaticResource Tia.ContextMenu}">
                                    <MenuItem Header="启用 / 停用" Command="{Binding ToggleModCommand}"
                                              Style="{StaticResource Tia.MenuItem}" />
                                    <MenuItem Header="删除模组" Command="{Binding DeleteModCommand}"
                                              Style="{StaticResource Tia.MenuItem}" />
                                    <Separator />
                                    <MenuItem Header="打开 mods 目录" Command="{Binding OpenModsFolderCommand}"
                                              Style="{StaticResource Tia.MenuItem}" />
                                    <MenuItem Header="打开模组主页" Command="{Binding OpenModPageCommand}"
                                              Style="{StaticResource Tia.MenuItem}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="图标" Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Width="40" Height="40" Margin="2">
                                                <Border Background="{DynamicResource Tia.PanelBgAlt}"
                                                        BorderBrush="{DynamicResource Tia.Border}" BorderThickness="1" />
                                                <Image Source="{Binding IconPath, Converter={StaticResource ModIcon}}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Border Background="{DynamicResource Tia.ClientPackBadge}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                        Padding="2,0" Opacity="0.9">
                                                    <TextBlock Text="{Binding LoaderText}" Foreground="White" FontSize="10" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="70" />
                                <DataGridTextColumn Header="名称" Binding="{Binding DisplayName}" Width="*" />
                                <DataGridTextColumn Header="版本" Binding="{Binding DisplayVersion}" Width="110" />
                                <DataGridTextColumn Header="模组 ID" Binding="{Binding ModId}" Width="150" />
                                <DataGridTextColumn Header="装载器" Binding="{Binding LoaderText}" Width="90" />
                                <DataGridTextColumn Header="作者" Binding="{Binding Authors}" Width="130" />
                                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- draggable divider: mod list above, details below -->
                        <GridSplitter Grid.Row="3" Style="{StaticResource Tia.Splitter.H}" />

                        <Border Grid.Row="4" Background="{DynamicResource Tia.PanelBg}"
                                BorderBrush="{DynamicResource Tia.Border}" BorderThickness="0,1,0,0"
                                Padding="10,6" MinHeight="120">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="360" />
                                </Grid.ColumnDefinitions>

                                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                    <!-- 选中模组的大图（取自 jar 内 logo），一眼分辨 -->
                                    <Grid DockPanel.Dock="Left" Width="104" Height="104" Margin="0,0,12,0"
                                          VerticalAlignment="Top">
                                        <Border Background="{DynamicResource Tia.PanelBgAlt}"
                                                BorderBrush="{DynamicResource Tia.Border}" BorderThickness="1" />
                                        <Image Source="{Binding SelectedMod.IconPath, Converter={StaticResource ModIcon}}"
                                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Border Background="{DynamicResource Tia.ClientPackBadge}"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Padding="3,0" Opacity="0.9">
                                            <TextBlock Text="{Binding SelectedMod.LoaderText}" Foreground="White"
                                                       FontSize="10" />
                                        </Border>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedModTitle}" Style="{StaticResource Tia.TextStrong}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="78" Margin="0,4,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SelectedModDetail}"
                                                           Style="{StaticResource Tia.MutedText}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SelectedModLinks}"
                                                           Style="{StaticResource Tia.MutedText}"
                                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Modrinth download -->
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{StaticResource ModLabel.ModrinthTitle}"
                                               Style="{StaticResource Tia.SectionHeader}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBox Width="200" Text="{Binding ModrinthProject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="输入 Modrinth 项目 slug 或 id，例如 jei / sodium / create" />
                                        <Button Style="{StaticResource Tia.Button.Tool}" Margin="6,0,0,0"
                                                Command="{Binding SearchModrinthCommand}"
                                                Content="{StaticResource ModLabel.Query}" />
                                    </StackPanel>
                                    <ListBox Height="86" Margin="0,6,0,0" ItemsSource="{Binding ModrinthHits}"
                                             Style="{StaticResource Tia.ListBox}"
                                             ItemContainerStyle="{StaticResource Tia.PaletteRow}"
                                             MouseDoubleClick="Modrinth_MouseDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Description}" Margin="10,0,0,0"
                                                               Style="{StaticResource Tia.PaletteGroupLabel}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Style="{StaticResource Tia.MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{StaticResource ModLabel.ModrinthHint}" />
                                    <!-- 可选任意 MC 版本 / 装载器（不再局限于已装实例） -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="游戏版本" Style="{StaticResource Tia.Label}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Width="150" Margin="6,0,0,0" IsEditable="True"
                                                  ItemsSource="{Binding ModGameVersions}"
                                                  SelectedItem="{Binding ModGameVersion, Mode=TwoWay}"
                                                  ToolTip="可直接输入版本号；列表含全部正式版 / 快照 / 旧版" />
                                        <TextBlock Text="装载器" Style="{StaticResource Tia.Label}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                                        <ComboBox Width="120" Margin="6,0,0,0"
                                                  ItemsSource="{Binding ModLoaders}"
                                                  SelectedItem="{Binding ModLoaderChoice, Mode=TwoWay}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ModSearchScopeText}" Style="{StaticResource Tia.MutedText}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ============ yggdrasil auth server: one terminal, nothing else -->
                <TabItem Header="认证服务端" Style="{StaticResource Tia.TabItem}">
                    <DockPanel Background="#10161B">
                        <!-- prompt line: the only input of this page -->
                        <Border DockPanel.Dock="Bottom" Background="#0B1116"
                                BorderBrush="#2A3540" BorderThickness="0,1,0,0">
                            <Grid Margin="8,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding YggPrompt}" Foreground="#7EC8F0"
                                           FontFamily="Consolas" FontSize="12.5" VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBox x:Name="YggInputBox" Grid.Column="1" Background="Transparent"
                                         BorderThickness="0" Foreground="#D6E2EA" CaretBrush="#D6E2EA"
                                         FontFamily="Consolas" FontSize="12.5" Padding="0"
                                         Text="{Binding YggInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="YggInput_KeyDown"
                                         ToolTip="输入命令后回车，例如: start / user add Steve 123456 / api / help" />
                            </Grid>
                        </Border>

                        <TextBox x:Name="YggConsoleBox" Style="{StaticResource Tia.Console}"
                                 Text="{Binding YggConsole.Text, Mode=OneWay}" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="NoWrap" FontSize="12.5"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </DockPanel>
                </TabItem>
                <!-- ============ modpacks: client packs and server packs -->
                <TabItem Header="整合包" Style="{StaticResource Tia.TabItem}">
                    <Grid Background="{DynamicResource Tia.PanelBg}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="90" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" MinHeight="150" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Tia.Toolbar}">
                            <!-- horizontal scroll keeps every action reachable on narrow windows -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource Tia.Button.Tool}" Content="导入客户端整合包…"
                                            Click="ImportClientPack_Click"
                                            ToolTip="支持 Modrinth .mrpack 与 zip 整合包，按客户端一侧下载文件" />
                                    <Button Style="{StaticResource Tia.Button.ServerPack}" Content="导入服务端整合包…"
                                            Click="ImportServerPack_Click"
                                            ToolTip="服务端整合包（zip / Forge·NeoForge 安装器 jar），按服务端一侧下载文件" />
                                    <Separator Style="{StaticResource Tia.Separator}" Margin="6,2" />
                                    <Button Style="{StaticResource Tia.Button.Primary}" Content="加入实例"
                                            Click="DeployPack_Click"
                                            ToolTip="把选中的客户端整合包复制进某个 Minecraft 实例（versions/版本），之后即可在「版本」页直接启动" />
                                    <Button Style="{StaticResource Tia.Button.Primary}" Content="启动服务端"
                                            Click="StartServerPack_Click"
                                            ToolTip="为选中的服务端整合包补齐 eula / server.properties，自动执行安装器后启动" />
                                    <Button Style="{StaticResource Tia.Button.Tool}" Content="停止服务端"
                                            Click="StopServerPack_Click" />
                                    <Separator Style="{StaticResource Tia.Separator}" Margin="6,2" />
                                    <Button Style="{StaticResource Tia.Button.Tool}" Content="扫描整合包"
                                            Click="ScanPacks_Click" />
                                    <Button Style="{StaticResource Tia.Button.Tool}" Content="删除"
                                            Click="DeletePack_Click" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Row="1" Background="{DynamicResource Tia.PanelBg}"
                                BorderBrush="{DynamicResource Tia.Border}" BorderThickness="0,0,0,1"
                                Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ModpackSummary}" Style="{StaticResource Tia.TextStrong}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ModpackStartText}" VerticalAlignment="Center"
                                           Margin="14,0,0,0" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Tia.ServerPackText}" />
                                <TextBlock Text="{Binding ModpacksPath}" Style="{StaticResource Tia.MutedText}"
                                           VerticalAlignment="Center" Margin="14,0,0,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="560" />
                            </StackPanel>
                        </Border>

                        <DataGrid EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Grid.Row="2" ItemsSource="{Binding ModpackList}"
                                  SelectedItem="{Binding SelectedModpack, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column" RowHeight="26" BorderThickness="0"
                                  Background="{DynamicResource Tia.PanelBg}"
                                  RowBackground="{DynamicResource Tia.ContentBg}"
                                  AlternatingRowBackground="{DynamicResource Tia.RowAlt}">
                            <DataGrid.ContextMenu>
                                <ContextMenu Style="{StaticResource Tia.ContextMenu}">
                                    <MenuItem Header="加入实例（复制 mods / config）"
                                              Click="DeployPack_Click"
                                              Style="{StaticResource Tia.MenuItem}" />
                                    <MenuItem Header="启动服务端（服务端整合包）"
                                              Click="StartServerPack_Click"
                                              Style="{StaticResource Tia.MenuItem}" />
                                    <MenuItem Header="停止服务端"
                                              Click="StopServerPack_Click"
                                              Style="{StaticResource Tia.MenuItem}" />
                                    <Separator />
                                    <MenuItem Header="打开目录"
                                              Click="OpenPackFolder_Click"
                                              Style="{StaticResource Tia.MenuItem}" />
                                    <MenuItem Header="复制服务端启动命令"
                                              Click="CopyPackCommand_Click"
                                              Style="{StaticResource Tia.MenuItem}" />
                                    <Separator />
                                    <MenuItem Header="删除整合包"
                                              Click="DeletePack_Click"
                                              Style="{StaticResource Tia.MenuItem}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <!-- 服务端整合包：橙色高亮 -->
                                        <DataTrigger Binding="{Binding IsServer}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Tia.ServerPackRow}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Tia.ServerPackText}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Tia.Selection}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="类型" Width="96">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,2">
                                                <Border x:Name="Badge" CornerRadius="2" Padding="6,1"
                                                        HorizontalAlignment="Left"
                                                        Background="{DynamicResource Tia.ClientPackBadge}">
                                                    <TextBlock Text="{Binding KindText}" Foreground="White"
                                                               FontSize="11" />
                                                </Border>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsServer}" Value="True">
                                                    <Setter TargetName="Badge" Property="Background"
                                                            Value="{DynamicResource Tia.ServerPackBadge}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="160" />
                                <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="64" />
                                <DataGridTextColumn Header="游戏" Binding="{Binding GameVersion}" Width="64" />
                                <DataGridTextColumn Header="装载器" Binding="{Binding Loader}" Width="80" />
                                <DataGridTextColumn Header="模组" Binding="{Binding ModCount}" Width="46" />
                                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="66" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- draggable divider between the pack list and the details -->
                        <GridSplitter Grid.Row="3" Style="{StaticResource Tia.Splitter.H}" />

                        <Border Grid.Row="4" Background="{DynamicResource Tia.PanelBg}"
                                BorderBrush="{DynamicResource Tia.Border}" BorderThickness="0,1,0,0"
                                Padding="10,6" MinHeight="120">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="420" />
                                </Grid.ColumnDefinitions>

                                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ModpackKindText}" Style="{StaticResource Tia.TextStrong}"
                                                   Foreground="{DynamicResource Tia.ServerPackText}" />
                                        <TextBlock Text="{Binding ModpackDetail}" Style="{StaticResource Tia.MutedText}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </ScrollViewer>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="服务端启动命令" Style="{StaticResource Tia.TextStrong}" />
                                    <TextBox Text="{Binding ModpackServerCommand, Mode=OneWay}" IsReadOnly="True"
                                             FontFamily="Consolas" FontSize="11.5" Margin="0,4,0,0" MinHeight="52"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="{DynamicResource Tia.ContentBg}" />
                                    <TextBlock Style="{StaticResource Tia.MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="服务端整合包会写入 eula.txt / server.properties / user_jvm_args.txt，并生成 tiamc-start.cmd；若包内有 Forge·NeoForge 安装器，点「启动服务端」时会先执行 --installServer。" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                <!-- ============ resource download center: mods / modpacks / resource packs / shaders -->
                <TabItem Header="资源下载" Style="{StaticResource Tia.TabItem}">
                    <Grid Background="{DynamicResource Tia.PanelBg}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="90" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" MinHeight="180" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Tia.Toolbar}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="类别" Style="{StaticResource Tia.Label}" VerticalAlignment="Center" />
                                    <ComboBox Width="92" ItemsSource="{Binding ResourceKinds}"
                                              SelectedItem="{Binding ResourceKindName, Mode=TwoWay}" />
                                    <TextBlock Text="关键词" Style="{StaticResource Tia.Label}" VerticalAlignment="Center"
                                               Margin="10,0,4,0" />
                                    <TextBox Width="190" Text="{Binding ResourceQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="支持中文名，例如 机械动力 / 钠 / BSL 光影" />
                                    <TextBlock Text="游戏版本" Style="{StaticResource Tia.Label}" VerticalAlignment="Center"
                                               Margin="10,0,4,0" />
                                    <ComboBox Width="110" IsEditable="True"
                                              ItemsSource="{Binding ResourceGameVersions}"
                                              Text="{Binding ResourceGameVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="装载器" Style="{StaticResource Tia.Label}" VerticalAlignment="Center"
                                               Margin="10,0,4,0" />
                                    <ComboBox Width="104" ItemsSource="{Binding ResourceLoaders}"
                                              SelectedItem="{Binding ResourceLoader, Mode=TwoWay}" />
                                    <Button Style="{StaticResource Tia.Button.Primary}" Content="搜索" Margin="10,0,0,0"
                                            Click="SearchResources_Click" />
                                    <Button Style="{StaticResource Tia.Button.ServerPack}" Content="下载到当前实例"
                                            Margin="6,0,0,0" Click="DownloadResource_Click"
                                            ToolTip="模组→mods，资源包→resourcepacks，光影→shaderpacks，整合包→安装并可选加入实例" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Row="1" Background="{DynamicResource Tia.PanelBg}"
                                BorderBrush="{DynamicResource Tia.Border}" BorderThickness="0,0,0,1" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ResourceStatus}" Style="{StaticResource Tia.TextStrong}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="900" />
                                <TextBlock Text="{Binding ResourceFolderHint}" Style="{StaticResource Tia.MutedText}"
                                           VerticalAlignment="Center" Margin="14,0,0,0" />
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Row="2" ItemsSource="{Binding ResourceHits}"
                                  SelectedItem="{Binding SelectedResourceHit, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column" RowHeight="58" BorderThickness="0"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  Background="{DynamicResource Tia.PanelBg}"
                                  RowBackground="{DynamicResource Tia.ContentBg}"
                                  AlternatingRowBackground="{DynamicResource Tia.RowAlt}">
                            <DataGrid.Columns>
                                <!-- 图标列：一眼分辨模组 / 整合包 / 资源包 / 光影 -->
                                <DataGridTemplateColumn Header="图标" Width="66">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Width="52" Height="52" Margin="2">
                                                <Border Background="{DynamicResource Tia.PanelBgAlt}"
                                                        BorderBrush="{DynamicResource Tia.Border}" BorderThickness="1" />
                                                <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Border Background="{DynamicResource Tia.ServerPackBadge}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                        Padding="3,0" Opacity="0.92"
                                                        Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                                    <TextBlock Text="{Binding KindShort}" Foreground="White" FontSize="10" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="名称" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="{DynamicResource Tia.Brand}" Padding="4,0" Margin="0,0,6,0"
                                                            CornerRadius="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding KindBadge}" Foreground="White" FontSize="10.5" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Tia.MutedText}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="支持版本" Binding="{Binding VersionsText}" Width="190" />
                                <DataGridTextColumn Header="slug" Binding="{Binding Slug}" Width="150" />
                                <DataGridTextColumn Header="更新" Binding="{Binding Updated}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter Grid.Row="3" Style="{StaticResource Tia.Splitter.H}" />

                        <Border Grid.Row="4" Background="{DynamicResource Tia.PanelBg}"
                                BorderBrush="{DynamicResource Tia.Border}" BorderThickness="0,1,0,0" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="420" />
                                </Grid.ColumnDefinitions>

                                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding ResourceDetail}" TextWrapping="Wrap" Style="{StaticResource Tia.MutedText}" />
                                </ScrollViewer>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="可用文件（双击下载）" Style="{StaticResource Tia.SectionHeader}" />
                                    <ListBox ItemsSource="{Binding ResourceFiles}" Style="{StaticResource Tia.ListBox}"
                                             SelectedItem="{Binding SelectedResourceFile, Mode=TwoWay}"
                                             Height="120" Margin="0,4,0,0"
                                             MouseDoubleClick="DownloadResource_Click">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="11.5" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Row="1" Grid.RowSpan="3" Grid.Column="3" Style="{StaticResource Tia.Splitter}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- right panes: properties (top) and instruction palette (bottom), draggable -->
            <Grid Grid.Row="1" Grid.RowSpan="3" Grid.Column="4"
                  Background="{DynamicResource Tia.PanelBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="150" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="*" MinHeight="150" />
                </Grid.RowDefinitions>

                <!-- property panel -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource Tia.Border}" BorderThickness="1,0,0,0"
                        Visibility="{Binding ShowProperties, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Tia.DockHeader}">
                        <TextBlock Text="属性 / 组态" VerticalAlignment="Center" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8,10,10">
                        <StackPanel>
                            <TextBlock Text="实例" Style="{StaticResource Tia.SectionHeader}" />
                            <TextBlock Text="{Binding DetailVersion}" Style="{StaticResource Tia.TextStrong}" Margin="0,4,0,2" />
                            <TextBlock Style="{StaticResource Tia.MutedText}" Text="{Binding DetailStatus}" />
                            <TextBlock Style="{StaticResource Tia.MutedText}" Text="{Binding DetailJarPath}"
                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />

                            <Separator Style="{StaticResource Tia.Separator}" Margin="0,10" />

                            <TextBlock Text="运行时" Style="{StaticResource Tia.SectionHeader}" />
                            <TextBlock Text="Java 运行时" Style="{StaticResource Tia.Label}" Margin="0,6,0,2" />

                            <TextBlock Text="Java 缺失自动补齐" Style="{StaticResource Tia.SectionHeader}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding JavaProvisionStatus}" Style="{StaticResource Tia.MutedText}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <CheckBox Content="缺失时自动下载到 runtime\java-N"
                                          IsChecked="{Binding AutoProvisionJava, Mode=TwoWay}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource Tia.Button.Primary}" Content="自动补齐 Java" Margin="10,0,0,0"
                                        Click="ProvisionJava_Click"
                                        ToolTip="检查当前实例需要的 Java 版本，缺失就下载（Adoptium / TUNA 镜像，SHA-256 校验）并解压到 runtime 目录" />
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding JavaChoices}" SelectedItem="{Binding SelectedJava, Mode=TwoWay}"
                                      DisplayMemberPath="ShortDisplay" />
                            <Button Style="{StaticResource Tia.Button}" Content="手动指定 java.exe..."
                                    Command="{Binding BrowseJavaCommand}" Margin="0,6,0,0" HorizontalAlignment="Left" />
                            <Button Style="{StaticResource Tia.Button}" Content="重新检测"
                                    Command="{Binding DetectJavaCommand}" Margin="0,4,0,0" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding JavaText}" Style="{StaticResource Tia.MutedText}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />

                            <Separator Style="{StaticResource Tia.Separator}" Margin="0,10" />

                            <TextBlock Text="内存与性能（本实例）" Style="{StaticResource Tia.SectionHeader}" />
                            <TextBlock Text="{Binding InstanceOverrideText}" Style="{StaticResource Tia.MutedText}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding MemoryText}" Style="{StaticResource Tia.TextStrong}" Margin="0,4,0,0" />
                            <TextBlock Text="最大内存 (MB)" Style="{StaticResource Tia.Label}" Margin="0,6,0,2" />
                            <Slider Minimum="1024" Maximum="32768" TickFrequency="1024" IsSnapToTickEnabled="True"
                                    Value="{Binding MaxMemoryMb, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource Tia.MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="只设置最大内存（-Xmx），不设置 -Xms，堆按需增长；上限为本机物理内存。" />
<TextBlock Text="垃圾回收器" Style="{StaticResource Tia.Label}" Margin="0,6,0,2" />
                            <ComboBox ItemsSource="{Binding GcModes}" SelectedItem="{Binding GcMode, Mode=TwoWay}" />


                            <Separator Style="{StaticResource Tia.Separator}" Margin="0,10" />

                            <TextBlock Text="自定义 JVM 参数（本实例）" Style="{StaticResource Tia.SectionHeader}" />
                            <TextBlock Text="{Binding JvmArgsStatus}" Style="{StaticResource Tia.MutedText}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBox Text="{Binding JvmArgsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="NoWrap" Height="76" Margin="0,4,0,0"
                                     FontFamily="Consolas" FontSize="11.5"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     ToolTip="每行一个参数，例如 -XX:MaxGCPauseMillis=37；与启动器同名（-Xmx / GC / -Dfile.encoding）时以这里为准" />
                            <TextBlock Text="{Binding JvmArgsWarnings}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Tia.Warn}"
                                       Visibility="{Binding JvmArgsWarnings, Converter={StaticResource TextToVisibility}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource Tia.Button.Primary}" Content="保存"
                                        Click="SaveJvmArgs_Click" ToolTip="写入本实例设置" />
                                <Button Style="{StaticResource Tia.Button}" Content="撤销修改" Margin="6,0,0,0"
                                        Click="UndoJvmArgs_Click" ToolTip="回到上次保存的值" />
                                <Button Style="{StaticResource Tia.Button.ServerPack}" Content="一键恢复默认" Margin="6,0,0,0"
                                        Click="ResetJvmArgs_Click" ToolTip="清空自定义参数，回到启动器托管的 -Xmx / GC 等默认设置" />
                                <Button Style="{StaticResource Tia.Button}" Content="恢复继承" Margin="6,0,0,0"
                                        Click="InheritJvmArgs_Click" ToolTip="清除本实例覆盖，改用全局默认参数" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ComboBox Width="210" ItemsSource="{Binding JvmPresets}"
                                          SelectedItem="{Binding JvmPresetName, Mode=TwoWay}" />
                                <Button Style="{StaticResource Tia.Button}" Content="设为全局默认" Margin="6,0,0,0"
                                        Click="ApplyJvmArgsGlobal_Click" />
                            </StackPanel>
                            <TextBlock Text="最终 JVM 参数（预览）" Style="{StaticResource Tia.Label}" Margin="0,8,0,2" />
                            <TextBox Text="{Binding JvmArgsPreview, Mode=OneWay}" IsReadOnly="True" Height="58"
                                     FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Background="{DynamicResource Tia.ContentBg}" />
                                                        <Separator Style="{StaticResource Tia.Separator}" Margin="0,10" />

                            <TextBlock Text="内存回收（Mem Reduct 风格）" Style="{StaticResource Tia.SectionHeader}" />
                            <TextBlock Text="{Binding MemoryTrimText}" Style="{StaticResource Tia.MutedText}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                            <CheckBox Content="清空所有进程工作集（EmptyWorkingSet，无需管理员）" Margin="0,6,0,0"
                                      IsChecked="{Binding TrimWorkingSets, Mode=TwoWay}" />
                            <CheckBox Content="清理待机页面列表 + 已修改页面（需管理员）" Margin="0,4,0,0"
                                      IsChecked="{Binding TrimStandbyList, Mode=TwoWay}" />
                            <CheckBox Content="清空系统文件缓存（需管理员）" Margin="0,4,0,0"
                                      IsChecked="{Binding TrimFileCache, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource Tia.Button.Primary}" Content="立即回收内存"
                                        Click="TrimMemory_Click"
                                        ToolTip="回收前/后可用内存会写进输出窗口" />
                                <CheckBox Content="自动回收" Margin="10,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{Binding AutoTrim, Mode=TwoWay}" />
                                <TextBox Width="52" Margin="6,0,0,0" VerticalAlignment="Center"
                                         Text="{Binding TrimIntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="分钟" Style="{StaticResource Tia.Label}" Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>


                            <TextBlock Text="窗口（本实例）" Style="{StaticResource Tia.Label}" Margin="0,8,0,2" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="宽" Style="{StaticResource Tia.Label}" VerticalAlignment="Center" />
                                <TextBox Width="62" Margin="4,0,0,0" Text="{Binding WindowWidth, Mode=TwoWay}" />
                                <TextBlock Text="高" Style="{StaticResource Tia.Label}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBox Width="62" Margin="4,0,0,0" Text="{Binding WindowHeight, Mode=TwoWay}" />
                            </StackPanel>
                            <CheckBox Content="全屏启动" Margin="0,6,0,0" IsChecked="{Binding Fullscreen, Mode=TwoWay}" />

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource Tia.Button}" Content="设为全局默认"
                                        Command="{Binding ApplyInstanceAsGlobalCommand}"
                                        ToolTip="把当前实例的设置写入全局默认值" />
                                <Button Style="{StaticResource Tia.Button}" Content="恢复继承" Margin="6,0,0,0"
                                        Command="{Binding ResetInstanceCommand}"
                                        ToolTip="清除当前实例的全部覆盖，回退到全局默认值" />
                            </StackPanel>
                            <TextBlock Text="{Binding GlobalDefaultsText}" Style="{StaticResource Tia.MutedText}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />



                            <TextBlock Text="路径与下载" Style="{StaticResource Tia.SectionHeader}" />
                            <TextBlock Text=".minecraft 目录" Style="{StaticResource Tia.Label}" Margin="0,6,0,2" />
                            <TextBox Text="{Binding RootPath, Mode=OneWay}" IsReadOnly="True"
                                     Background="{DynamicResource Tia.PanelBgAlt}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource Tia.Button.Primary}" Content="自动检测"
                                        Command="{Binding AutoDetectRootCommand}"
                                        ToolTip="扫描本机所有 Minecraft 目录（注册表 / 其它启动器 / 磁盘扫描）" />
                                <Button Style="{StaticResource Tia.Button}" Content="浏览..." Margin="6,0,0,0"
                                        Command="{Binding BrowseRootCommand}" />
                            </StackPanel>

                            <Separator Style="{StaticResource Tia.Separator}" Margin="0,10" />

                            <TextBlock Text="版本隔离" Style="{StaticResource Tia.SectionHeader}" />
                            <CheckBox Content="每个版本使用独立目录（config/saves/mods 隔离）" Margin="0,6,0,0"
                                      IsChecked="{Binding IsolateInstances, Mode=TwoWay}"
                                      ToolTip="全局开关：开启后 --gameDir 指向 versions\ 下的实例目录" />
                            <CheckBox Content="当前实例强制隔离（覆盖全局开关）" Margin="0,6,0,0"
                                      IsChecked="{Binding IsolateThisInstance, Mode=TwoWay}"
                                      ToolTip="只为选中的实例打开/关闭隔离" />
                            <TextBlock Text="{Binding IsolationText}" Style="{StaticResource Tia.MutedText}"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="启动时的游戏目录" Style="{StaticResource Tia.Label}" Margin="0,6,0,2" />
                            <TextBox Text="{Binding GameDirText, Mode=OneWay}" IsReadOnly="True"
                                     Background="{DynamicResource Tia.PanelBgAlt}" />
                            <CheckBox Content="便携模式：文件放在程序目录" Margin="0,10,0,0"
                                      IsChecked="{Binding PortableRoot, Mode=TwoWay}"
                                      ToolTip="在程序目录下创建 minecraft 文件夹并切换过去（默认开启）" />
                            <TextBlock Text="{Binding PortableText}" Style="{StaticResource Tia.MutedText}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                            <CheckBox Content="使用 BMCLAPI 镜像" Margin="0,10,0,0" IsChecked="{Binding UseBmclApi, Mode=TwoWay}" />
                            <CheckBox Content="启动前校验文件" Margin="0,6,0,0" IsChecked="{Binding AutoCheckFiles, Mode=TwoWay}" />
                            <CheckBox Content="自动补全缺失文件" Margin="0,6,0,0" IsChecked="{Binding AutoDownloadMissing, Mode=TwoWay}" />

                            <Separator Style="{StaticResource Tia.Separator}" Margin="0,10" />

                            <TextBlock Text="高级" Style="{StaticResource Tia.SectionHeader}" />
                            <TextBlock Text="附加 classpath（; 分隔）" Style="{StaticResource Tia.Label}" Margin="0,6,0,2" />
                            <TextBox Text="{Binding ExtraClasspath, Mode=TwoWay}" />
                            <TextBlock Text="环境变量（每行 KEY=VALUE）" Style="{StaticResource Tia.Label}" Margin="0,6,0,2" />
                            <TextBox Height="52" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     Text="{Binding EnvironmentVariables, Mode=TwoWay}" />
                            <Button Style="{StaticResource Tia.Button.Primary}" Content="保存配置"
                                    Command="{Binding SaveConfigCommand}" Margin="0,10,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
                </Border>

                <!-- draggable divider between the properties and the palette -->
                <GridSplitter Grid.Row="1" Style="{StaticResource Tia.Splitter.H}" />

                <!-- instruction palette: TIA style collapsible command groups -->
                <Border Grid.Row="2" Background="{DynamicResource Tia.PanelBg}"
                        BorderBrush="{DynamicResource Tia.Border}" BorderThickness="1,0,0,0"
                        Visibility="{Binding ShowPalette, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource Tia.DockHeader}">
                            <TextBlock Text="指令" VerticalAlignment="Center" />
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PaletteSections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <ToggleButton Style="{StaticResource Tia.PaletteHeaderToggle}"
                                                          Content="{Binding Title}"
                                                          IsChecked="{Binding IsExpanded, Mode=TwoWay}" />
                                            <ListBox ItemsSource="{Binding VisibleItems}"
                                                     Style="{StaticResource Tia.ListBox}"
                                                     ItemContainerStyle="{StaticResource Tia.PaletteRow}"
                                                     BorderThickness="0" Background="Transparent"
                                                     MouseDoubleClick="Palette_MouseDoubleClick"
                                                     Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"
                                                                  Fill="{DynamicResource Tia.Brand}" Width="13" Height="13"
                                                                  Stretch="Uniform" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Name}" Margin="5,0,0,0"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Description}" Margin="10,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Style="{StaticResource Tia.PaletteGroupLabel}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- vertical pane selector -->
            <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="5"
                    Background="{DynamicResource Tia.PanelBgAlt}"
                    BorderBrush="{DynamicResource Tia.Border}" BorderThickness="1,0,0,0">
                <StackPanel Margin="0,6,0,0">
                    <RadioButton Style="{StaticResource Tia.PaneTab}" GroupName="RightPane" Content="属性"
                                 IsChecked="{Binding RightPane, Converter={StaticResource IntEquals}, ConverterParameter=0}" />
                    <RadioButton Style="{StaticResource Tia.PaneTab}" GroupName="RightPane" Content="指令"
                                 IsChecked="{Binding RightPane, Converter={StaticResource IntEquals}, ConverterParameter=1}" />
                </StackPanel>
            </Border>

            <!-- console strip -->
            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5"
                    Background="{DynamicResource Tia.PanelBg}"
                    BorderBrush="{DynamicResource Tia.Border}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Tia.PanelBgAlt}"
                            BorderBrush="{DynamicResource Tia.Border}" BorderThickness="0,0,0,1">
                        <Grid Margin="8,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="输出窗口" Style="{StaticResource Tia.TextStrong}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StateMessage}" Style="{StaticResource Tia.MutedText}"
                                           Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource Tia.Button.Tool}" Content="复制"
                                        Command="{Binding CopyConsoleCommand}" />
                                <Button Style="{StaticResource Tia.Button.Tool}" Content="清空"
                                        Command="{Binding ClearConsoleCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBox x:Name="ConsoleStrip" Style="{StaticResource Tia.Console}"
                             Text="{Binding Console.Text, Mode=OneWay}" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>

            <!-- draggable divider above the output window (left four columns; the right pane spans all rows) -->
            <GridSplitter Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                          Style="{StaticResource Tia.Splitter.H}" Panel.ZIndex="10" />
        </Grid>

        <!-- ==================================================== status bar -->
        <Border Grid.Row="4" Style="{StaticResource Tia.StatusBar}">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource Tia.StatusText}"
                           Text="{Binding StateText, StringFormat=状态: {0}}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Style="{StaticResource Tia.StatusSeparator}" Margin="8,5" />
                <TextBlock Grid.Column="2" Style="{StaticResource Tia.StatusText}" Text="{Binding StateMessage}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                <ProgressBar Grid.Column="3" Width="180" Height="12" Margin="0,0,10,0" VerticalAlignment="Center"
                             Minimum="0" Maximum="100" Value="{Binding DownloadPercent, Mode=OneWay}"
                             Visibility="{Binding DownloadStatus, Converter={StaticResource NotNullToVisibility}}" />
                <TextBlock Grid.Column="4" Style="{StaticResource Tia.StatusText}"
                           Text="{Binding DownloadStatus}" VerticalAlignment="Center" Margin="0,0,10,0" />

                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Tia.StatusText}" Text="{Binding DetailVersion}"
                               VerticalAlignment="Center" />
                    <Border Style="{StaticResource Tia.StatusSeparator}" Margin="8,5" />
                    <TextBlock Style="{StaticResource Tia.StatusText}" Text="{Binding DownloadSourceText}"
                               VerticalAlignment="Center" />
                    <Border Style="{StaticResource Tia.StatusSeparator}" Margin="8,5" />
                    <TextBlock Style="{StaticResource Tia.StatusText}"
                               Text="{Binding RootPath}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="320" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
