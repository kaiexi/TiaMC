<Window x:Class="TiaMc.App.Views.DeviceCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TiaMc.App.ViewModels"
        Title="Microsoft 正版登录"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Tia.WindowBg}"
        Foreground="{DynamicResource Tia.Text}"
        FontFamily="Segoe UI" FontSize="12">
    <Window.DataContext>
        <vm:DeviceCodeViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Tia.Brand}" Height="30">
            <TextBlock Text="Microsoft 正版账户登录" VerticalAlignment="Center" Margin="10,0"
                       Foreground="{DynamicResource Tia.TextOnBrand}" FontWeight="SemiBold" />
        </Border>

        <StackPanel Grid.Row="1" Margin="16,14,16,6">
            <TextBlock Text="1. 在浏览器中打开下面的网址" Style="{StaticResource Tia.SectionHeader}" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBox Text="{Binding VerificationUri, Mode=OneWay}" IsReadOnly="True" Width="330"
                         Background="{DynamicResource Tia.PanelBgAlt}" />
                <Button Style="{StaticResource Tia.Button}" Content="打开浏览器" Margin="8,0,0,0"
                        Command="{Binding OpenLinkCommand}" />
            </StackPanel>

            <TextBlock Text="2. 输入下面的设备代码" Style="{StaticResource Tia.SectionHeader}" Margin="0,14,0,0" />
            <Border Style="{StaticResource Tia.Card}" Margin="0,6,0,0" Background="{DynamicResource Tia.PanelBgAlt}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding UserCode, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="30" FontWeight="Bold"
                               Foreground="{DynamicResource Tia.Brand}" VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Style="{StaticResource Tia.Button}" Content="复制代码"
                                Command="{Binding CopyCodeCommand}" />
                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Tia.MutedText}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="3. 登录 Microsoft 账户并同意授权，本窗口会自动完成后续步骤"
                       Style="{StaticResource Tia.MutedText}" Margin="0,12,0,0" TextWrapping="Wrap" />

            <Border Margin="0,12,0,0" Padding="8,6" BorderThickness="1"
                    BorderBrush="{DynamicResource Tia.Border}" Background="{DynamicResource Tia.ContentBg}">
                <StackPanel>
                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Tia.MutedText}" TextWrapping="Wrap"
                               Margin="0,4,0,0" MaxHeight="120" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,8,16,14">
            <Button Style="{StaticResource Tia.Button}" Content="关闭" Width="90" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
