<UserControl x:Class="TiaMc.App.Controls.PortalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 门户视图启动页：颜色取自真 TIA Portal 界面取样 -->
    <Grid Background="#1B2030">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
                <RowDefinition Height="6" />
            </Grid.RowDefinitions>

            <!-- 品牌条 -->
            <Border Grid.Row="0" Background="#1C1C1C">
                <Grid Margin="10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="13" Height="13" Background="#FF8000" Margin="0,0,7,0" />
                        <TextBlock Text="TIA-MC" Foreground="White" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Totally Integrated Automation" Foreground="#F0F0F0" FontSize="11"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="PORTAL" Foreground="#4FA3E3" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Right" Margin="0,-2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主体：左导航 + 中间任务 + 右侧内容 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" MinWidth="260" />
                </Grid.ColumnDefinitions>

                <!-- 左：大图标导航（激活项左侧橙条 + 深底白字） -->
                <Grid Grid.Column="0" Background="#1B2030">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <!-- 激活项：启动 -->
                        <Grid Background="#3C4561" Height="86">
                            <Border Width="4" HorizontalAlignment="Left" Background="#FF8000" />
                            <StackPanel Margin="18,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="启动" Foreground="White" FontSize="15" />
                                <TextBlock Text="门户视图" Foreground="#C7CCDA" FontSize="10" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Button Command="{Binding GoWorkspaceTabCommand}" CommandParameter="4" Height="70"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                HorizontalContentAlignment="Left">
                            <StackPanel Margin="18,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="实例" Foreground="#D6DAE6" FontSize="14" />
                                <TextBlock Text="版本 / 加载器" Foreground="#9AA2B6" FontSize="10" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GoWorkspaceTabCommand}" CommandParameter="8" Height="70"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                HorizontalContentAlignment="Left">
                            <StackPanel Margin="18,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="整合包" Foreground="#D6DAE6" FontSize="14" />
                                <TextBlock Text="客户端 / 服务端" Foreground="#9AA2B6" FontSize="10" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GoWorkspaceTabCommand}" CommandParameter="9" Height="70"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                HorizontalContentAlignment="Left">
                            <StackPanel Margin="18,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="资源下载" Foreground="#D6DAE6" FontSize="14" />
                                <TextBlock Text="模组 / 资源包 / 光影" Foreground="#9AA2B6" FontSize="10" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="#2A3145" Margin="14,6" />

                        <Button Command="{Binding GoWorkspaceTabCommand}" CommandParameter="3" Height="70"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                HorizontalContentAlignment="Left">
                            <StackPanel Margin="18,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="在线与诊断" Foreground="#D6DAE6" FontSize="14" />
                                <TextBlock Text="Java / 日志" Foreground="#9AA2B6" FontSize="10" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 左下：切回项目视图 -->
                    <Button Grid.Row="1" Command="{Binding ShowProjectViewCommand}" Height="34" Margin="0,0,0,4"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            HorizontalContentAlignment="Left" ToolTip="切回项目视图（功能区 + 项目树）">
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <TextBlock Text="▶" Foreground="#FF8000" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="项目视图" Foreground="#D6DAE6" FontSize="12" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 中：任务列表（圆点 + 文字，分组） -->
                <Border Grid.Column="1" Background="#3C4561">
                    <StackPanel Margin="26,40,16,0">
                        <Button Command="{Binding PortalOpenCommand}" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" HorizontalContentAlignment="Left" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●" Foreground="#FF8000" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="打开现有实例" Foreground="White" FontSize="14" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GoWorkspaceTabCommand}" CommandParameter="4" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●" Foreground="#8C93A8" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="新建实例" Foreground="#E2E6EF" FontSize="14" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GoWorkspaceTabCommand}" CommandParameter="8" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●" Foreground="#8C93A8" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="导入整合包" Foreground="#E2E6EF" FontSize="14" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowProjectViewCommand}" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●" Foreground="#8C93A8" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="关闭门户视图" Foreground="#E2E6EF" FontSize="14" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="#4E5878" Margin="0,6,0,18" />

                        <Button Command="{Binding GoWorkspaceTabCommand}" CommandParameter="0" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●" Foreground="#8C93A8" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="欢迎光临" Foreground="#E2E6EF" FontSize="14" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenHelpCommand}" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" HorizontalContentAlignment="Left" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●" Foreground="#8C93A8" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="新手上路" Foreground="#E2E6EF" FontSize="14" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="#4E5878" Margin="0,6,0,18" />

                        <Button Command="{Binding GoWorkspaceTabCommand}" CommandParameter="3" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●" Foreground="#8C93A8" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="已安装的软件" Foreground="#E2E6EF" FontSize="14" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenHelpCommand}" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" HorizontalContentAlignment="Left" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●" Foreground="#8C93A8" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="帮助" Foreground="#E2E6EF" FontSize="14" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 右：内容面板（打开现有实例 + 最近使用的 + 按钮排） -->
                <Grid Grid.Column="2" Background="#F0F0F0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="18,22,18,0">
                        <TextBlock Text="打开现有实例" Foreground="#111111" FontSize="17" />
                        <Border Height="1" Background="#8A8A8A" Margin="0,6,0,0" />
                        <TextBlock Text="最近使用的" Foreground="#111111" FontSize="13" Margin="0,12,0,6" />
                    </StackPanel>

                    <DataGrid Grid.Row="1" Margin="18,0,18,0" ItemsSource="{Binding VersionChoices}"
                              SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                              AutoGenerateColumns="False" HeadersVisibility="Column" RowHeight="20"
                              Background="White" BorderBrush="#8A8A8A" BorderThickness="1"
                              RowBackground="White" AlternatingRowBackground="White"
                              SelectionMode="Single" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="实例" Binding="{Binding Id}" Width="150" />
                            <DataGridTextColumn Header="加载器" Binding="{Binding Loader}" Width="110" />
                            <DataGridTextColumn Header="路径" Binding="{Binding JsonPath}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="18,10,18,18">
                        <CheckBox Content="激活基本的完整性检查" IsChecked="{Binding PortalCheckBeforeLaunch, Mode=TwoWay}"
                                  Foreground="#111111" Margin="0,0,0,12" />
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="浏览…" Command="{Binding OpenGameFolderCommand}" Width="86" Height="24"
                                        Margin="0,0,8,0" ToolTip="打开实例所在目录" />
                                <Button Content="删除" Command="{Binding DeleteVersionCommand}" Width="86" Height="24" />
                            </StackPanel>
                            <Button Content="打开" Command="{Binding PortalOpenCommand}" Width="110" Height="24"
                                    HorizontalAlignment="Right"
                                    ToolTip="启动选中实例（勾选上面时先做完整性检查）" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="#282F47" />
        </Grid>
</UserControl>
