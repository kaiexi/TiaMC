<Application x:Class="TiaMc.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TiaMc.App.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/TiaTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:PathShortenConverter x:Key="PathShorten" />
            <conv:LogLevelBrushConverter x:Key="LogLevelBrush" />
            <conv:SeverityBrushConverter x:Key="SeverityBrush" />
            <conv:ListJoinConverter x:Key="ListJoin" />
            <conv:ModIconConverter x:Key="ModIcon" />
            <conv:TextToVisibilityConverter x:Key="TextToVisibility" />
            <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
            <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometry" />
            <conv:InstalledTextConverter x:Key="InstalledText" />
            <conv:SkinHeadConverter x:Key="SkinHead" />
            <conv:BoolToRunTextConverter x:Key="BoolToRunText" />
            <conv:IntEqualsConverter x:Key="IntEquals" />

            <!-- Window / taskbar icon. Declared as a resource next to the pack
                 URI so it also resolves from a single-file publish. -->
            <BitmapImage x:Key="App.Icon" UriSource="pack://application:,,,/Assets/TiaMC.ico" />

            <!-- Toolbar captions, kept short like the TIA Portal toolbar. -->
            <sys:String x:Key="ToolLabel.Save">保存工程</sys:String>
            <sys:String x:Key="ToolLabel.Refresh">刷新</sys:String>
            <sys:String x:Key="ToolLabel.Check">校验文件</sys:String>
            <sys:String x:Key="ToolLabel.Download">下载</sys:String>
            <sys:String x:Key="ToolLabel.Online">启动游戏</sys:String>
            <sys:String x:Key="ToolLabel.Offline">结束游戏</sys:String>
            <sys:String x:Key="ToolLabel.Manifest">版本清单</sys:String>

            <!-- Mods workspace captions. -->
            <sys:String x:Key="ModLabel.Refresh">刷新列表</sys:String>
            <sys:String x:Key="ModLabel.Import">导入模组…</sys:String>
            <sys:String x:Key="ModLabel.Toggle">启用 / 停用</sys:String>
            <sys:String x:Key="ModLabel.Delete">删除</sys:String>
            <sys:String x:Key="ModLabel.Folder">打开模组目录</sys:String>
            <sys:String x:Key="ModLabel.Browse">指定目录…</sys:String>
            <sys:String x:Key="ModLabel.Query">搜索</sys:String>
            <sys:String x:Key="ModLabel.ModrinthTitle">Modrinth 在线下载</sys:String>
            <sys:String x:Key="ModLabel.EmptyHint">这个目录里还没有模组文件。可以用「导入模组…」，或在右侧用 Modrinth 搜索下载；被停用的模组会以 .disabled 后缀留在列表里。</sys:String>
            <sys:String x:Key="ModLabel.ModrinthHint">输入 Modrinth 项目名或 ID（例如 jei、sodium、create）后点「搜索」；双击结果即可下载到当前实例的 mods 目录。</sys:String>

            <!-- Minecraft folder detection dialog. -->
            <sys:String x:Key="ScanLabel.Scan">Scan all</sys:String>
            <sys:String x:Key="ScanLabel.ScanFast">Quick scan</sys:String>
            <sys:String x:Key="ScanLabel.Browse">Browse...</sys:String>
            <sys:String x:Key="ScanLabel.Hint">Scan all also walks every fixed drive (a few seconds). Locations checked: %APPDATA%\.minecraft, the user profile, the official launcher registry keys, PCL2 / HMCL / BakaXL / MultiMC / Prism data folders and the Microsoft Store package folder. Double click a row to use that folder.</sys:String>

            <!-- Window chrome geometry (kept here so the theme stays reusable). -->
            <Geometry x:Key="Chrome.Minimize">M0,0 L10,0 L10,1 L0,1 Z</Geometry>
            <Geometry x:Key="Chrome.Maximize">M0,0 L10,0 L10,10 L0,10 Z M1,1 L1,9 L9,9 L9,1 Z</Geometry>
            <Geometry x:Key="Chrome.Restore">M0,2 L8,2 L8,10 L0,10 Z M2,2 L2,0 L10,0 L10,8 L8,8 L8,2 Z</Geometry>
            <Geometry x:Key="Chrome.Close">M0,0 L1,0 L5,4 L9,0 L10,0 L10,1 L6,5 L10,9 L10,10 L9,10 L5,6 L1,10 L0,10 L0,9 L4,5 L0,1 Z</Geometry>
        </ResourceDictionary>
    </Application.Resources>
</Application>
